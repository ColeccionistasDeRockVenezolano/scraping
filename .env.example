# CRV — variables de entorno (copiar a .env, nunca commitear .env real)

# --- Base de datos ---
# public = core canónico; el usuario de la app NO necesita permisos de
# escritura en public salvo el rol que use el merge engine.
# Coincide con docker-compose.yml (`npm run db:up`). Puerto 5433 para no
# chocar con otro PostgreSQL local en 5432.
DATABASE_URL=postgresql://crv:crv@127.0.0.1:5433/crv

# --- API ---
PORT=8080
HOST=127.0.0.1
# Bearer legado solo para automatizaciones internas. Déjalo vacío si todos
# los colaboradores usan el login web.
CRV_OPERATOR_TOKEN=
# Firma por defecto de las decisiones (se puede sobrescribir por petición con X-CRV-Operator).
CRV_OPERATOR_NAME=operador
# Cuentas de la interfaz. Solo hashes scrypt; el comando recomendado añade o
# rota una cuenta sin escribir su contraseña en el historial de la terminal:
# `npm run auth:set-collaborator -- usuario "Nombre visible"`.
CRV_COLLABORATORS_JSON=
# Login compartido con herra (coleccionistasderockvenezolano.com): ruta a su
# SQLite. Se abre en solo lectura; entran los usuarios aprobados del proyecto,
# sus administradores y el superadministrador, con la misma contraseña que en
# la web. Vacío = solo las cuentas del JSON anterior.
CRV_HERRA_DB_PATH=
CRV_HERRA_PROJECT_SLUG=coleccionistas-rock-venezolano
# Las sesiones viven en memoria del servidor y expiran aunque el navegador siga abierto.
CRV_SESSION_TTL_HOURS=12
# En producción bajo /crv limita la cookie a esa aplicación; en desarrollo directo se usa /.
CRV_SESSION_COOKIE_PATH=/
# Orígenes adicionales para desarrollo; el origen público servido por el mismo host se admite automáticamente.
CRV_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Almacenamiento crudo ---
DATA_DIR=./data

# --- Fetcher / crawling ---
CRAWL_USER_AGENT=CRV-bot/0.1 (+contacto: definir)
CRAWL_TIMEOUT_MS=15000
CRAWL_DELAY_MS=1000
CRAWL_MAX_RETRIES=3
CRAWL_CACHE_TTL_DAYS=7

# --- YouTube Data API (F3; opcional — sin ella el sistema funciona igual) ---
YOUTUBE_API_KEY=
# Presupuesto diario en unidades de cuota (YouTube concede 10.000). `yt:enrich-artist`
# no busca si lo gastado hoy no deja margen para una search.list (100 unidades).
YOUTUBE_DAILY_QUOTA_UNITS=10000

# --- DeepSeek (F6; opcional — sin ella el sistema funciona igual, solo rutas deterministas) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# IDs configurables: el codigo selecciona por rol fast/reasoning/vision, no
# compara ni acopla logica a un nombre concreto de modelo.
DEEPSEEK_MODEL_FAST=deepseek-v4-flash-0731
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro-0813
DEEPSEEK_MODEL_VISION=deepseek-v4-flash-vision-exp
DEEPSEEK_MAX_TOKENS_PER_RUN=4000
DEEPSEEK_TIMEOUT_MS=30000

# --- Entity resolution (0..1; orden estricto) ---
ER_AUTO_MATCH_THRESHOLD=0.90
ER_POSSIBLE_MATCH_THRESHOLD=0.72
ER_REVIEW_THRESHOLD=0.50
ER_NO_MATCH_THRESHOLD=0.00
ER_MINIMUM_MARGIN=0.08

# --- Logs ---
LOG_LEVEL=info
