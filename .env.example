# CRV — variables de entorno (copiar a .env, nunca commitear .env real)

# --- Base de datos ---
# public = core canónico; el usuario de la app NO necesita permisos de
# escritura en public salvo el rol que use el merge engine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crv

# --- API ---
PORT=8080
HOST=127.0.0.1

# --- Almacenamiento crudo ---
DATA_DIR=./data

# --- Fetcher / crawling ---
CRAWL_USER_AGENT=CRV-bot/0.1 (+contacto: definir)
CRAWL_TIMEOUT_MS=15000
CRAWL_DELAY_MS=1000
CRAWL_MAX_RETRIES=3
CRAWL_CACHE_TTL_DAYS=7

# --- YouTube Data API (F3; opcional — sin ella el sistema funciona igual) ---
YOUTUBE_API_KEY=

# --- DeepSeek (F6; opcional — sin ella el sistema funciona igual, solo rutas deterministas) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS_PER_RUN=4000

# --- Logs ---
LOG_LEVEL=info
