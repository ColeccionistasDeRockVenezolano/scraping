# CRV — interfaz (copiar a .env.local, nunca commitear un .env real)

# URL base de la API Fastify (src/api/server.ts). En dev, por defecto
# http://127.0.0.1:8080 (HOST/PORT del .env del backend). El build público
# (`build:public`, prefijo /crv/) no la necesita: usa /crv/api del mismo origen.
VITE_API_BASE_URL=http://127.0.0.1:8080
