{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://soundcloud.com/norberto-fornerino", "cita": "Norberto Fornerino (Aka Forne) inicia su camino en la escena electrónica venezolana a finales de los 90 en el circuito de minitecas como DJ, y a principios del 2000 como productor."}, {"url": "https://soundcloud.com/norberto-fornerino", "cita": "Su firma destaca en el emblemático compilado Venezuela Electrónica Vol. 3, así como en las series Venezuela Master Compilation Vol. 1, 2 y 3 (SL Records) y Venezuelan Series (I AM Music Records)."}, {"url": "https://soundcloud.com/norberto-fornerino", "cita": "Norberto Fornerino - Natural Party (Original Mix)"}], "pais": "Venezuela", "ciudad": null, "año_formacion": null, "generos": [{"genero": "House", "url": "https://soundcloud.com/norberto-fornerino", "cita": "# House"}, {"genero": "Deep House", "url": "https://soundcloud.com/norberto-fornerino", "cita": "consolidándose como una de las mayores referencias underground del Deep House y el Techno en el país."}, {"genero": "Techno", "url": "https://soundcloud.com/norberto-fornerino", "cita": "consolidándose como una de las mayores referencias underground del Deep House y el Techno en el país."}], "datos_para_biografia": [{"dato": "Inició su carrera en la escena electrónica venezolana a finales de los 90 en el circuito de minitecas como DJ y a principios de los 2000 como productor.", "url": "https://soundcloud.com/norberto-fornerino", "cita": "Norberto Fornerino (Aka Forne) inicia su camino en la escena electrónica venezolana a finales de los 90 en el circuito de minitecas como DJ, y a principios del 2000 como productor."}, {"dato": "Es fundador de los colectivos creativos Natural Party, Comun klam y FOMO, y fue creador y locutor de los radio shows \"Magia Electrónica\" y \"Conexión Electrónica\".", "url": "https://soundcloud.com/norberto-fornerino", "cita": "destacando como creador y locutor de los sintonizados radio shows \"Magia Electrónica\" y \"Conexión Electrónica\". Asimismo, es el fundador de los colectivos creativos Natural Party, Comun klam y FOMO, marcas con las que ha impulsado activamente la escena local."}, {"dato": "Fundó su propio sello discográfico Natural Records y fue miembro de la academia de los Premios Pepsi Music Venezuela en la categoría de música electrónica.", "url": "https://soundcloud.com/norberto-fornerino", "cita": "Además de fundar su propio sello discográfico, Natural Records, ha editado tracks bajo firmas como In Progresso Records, CE Records, Music Taste Records e Incense Records."}]}
