{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=wl5HFAEstWo", "cita": "Cómprame - Dandy León\nLetra: Ignacio Umérez\nMúsica: Ignacio Umérez y Juan Bruestlen"}, {"url": "https://www.youtube.com/watch?v=YrmfyIPCSXc", "cita": "#dandyleon #sonlomaximo #nuevasbandas #nuevasbandas2015"}, {"url": "https://soundcloud.com/dandygrrr", "cita": "Comprame\nDandy León"}, {"url": "https://www.youtube.com/@DandyLe%C3%B3n/about", "cita": "Venezuela"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/@DandyLe%C3%B3n/about", "cita": "Venezuela"}, "ciudad": {"valor": "Caracas", "url": "https://soundcloud.com/dandygrrr", "cita": "Caracas, Bolivarian Republic of Venezuela"}, "año_formacion": null, "generos": [{"genero": "Pop-Rock", "url": "https://soundcloud.com/dandygrrr", "cita": "Todo esto sin dejar a un lado que Dandy León es principalmente una propuesta Pop-Rock."}, {"genero": "psicotropical", "url": "https://soundcloud.com/dandygrrr", "cita": "Ignacio Umérez, vocalista, guitarrista y compositor define el sonido de la banda con una sola palabra: “psicotropical”."}], "datos_para_biografia": [{"dato": "Dandy León se presenta como agrupación independiente que encuentra inspiración en la mujer y su sensualidad.", "url": "https://soundcloud.com/dandygrrr", "cita": "Con un meticuloso sonido, Dandy León se presenta como una agrupación independiente que encuentra inspiración en la mujer y su sensualidad para expresar la compleja interacción que se vive diariamente en una relación de pareja."}, {"dato": "El tema «Cómprame» fue publicado el 13 feb 2015 y figura en el álbum «Todo Es Bello», con letra de Ignacio Umérez y música de Ignacio Umérez y Juan Bruestlen.", "url": "https://www.youtube.com/watch?v=wl5HFAEstWo", "cita": "Cómprame - Dandy León\nLetra: Ignacio Umérez\nMúsica: Ignacio Umérez y Juan Bruestlen\nGuitarra y voces: Ignacio Umérez\nGuitarra y coros: Juan Bruestlen\nBajo: Carlos Sácnhez\nBatería: Luis Rojas"}, {"dato": "Alineación de la grabación: Ignacio Umérez (guitarra y voces), Juan Bruestlen (guitarra y coros), Carlos Sánchez (bajo) y Luis Rojas (batería).", "url": "https://www.youtube.com/watch?v=wl5HFAEstWo", "cita": "Guitarra y voces: Ignacio Umérez\nGuitarra y coros: Juan Bruestlen\nBajo: Carlos Sácnhez\nBatería: Luis Rojas"}]}
