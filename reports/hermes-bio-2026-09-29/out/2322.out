{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "Álbum: Capitulo Trujillo ... Lugar: Trujillo - Venezuela ... 19. ZAIRE - Zona Peligrosa 3:10"}, {"url": "https://metallethal.com.ve/metalkinesia/capitulo-trujillo.html", "cita": "19. ZAIRE Zona Peligrosa 3:10"}, {"url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Banda: Zaire\r\nGenero: Metal alternativo \r\nLugar: Trujillo Venezuela\r\nDemo: Zona Peligrosa"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Banda: Zaire\r\nGenero: Metal alternativo \r\nLugar: Trujillo Venezuela\r\nDemo: Zona Peligrosa"}, "ciudad": {"valor": "Trujillo", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Formados en Trujillo Venezuela de los miembros de la Banda Aker quienes ya tenían desde 1995 tocando a comienzos del 2000 influenciados por el movimiento global del Nu Metal que predominaba en la época deciden Formar Zaire"}, "año_formacion": null, "generos": [{"genero": "Metal alternativo", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Banda: Zaire\r\nGenero: Metal alternativo"}, {"genero": "Nu Metal", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "a comienzos del 2000 influenciados por el movimiento global del Nu Metal que predominaba en la época deciden Formar Zaire"}], "datos_para_biografia": [{"dato": "Se formó con miembros de la banda Aker, que ya tocaba desde 1995, y hacia comienzos del 2000 mezcló voces rap con su sonido de metal de los 90 y letras de realidad social.", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Formados en Trujillo Venezuela de los miembros de la Banda Aker quienes ya tenían desde 1995 tocando a comienzos del 2000 influenciados por el movimiento global del Nu Metal que predominaba en la época deciden Formar Zaire Mesclando voces Rap a su sonido de Metal característico de los 90`s así como también crudas letras de realidad social"}, {"dato": "Llegó a compartir escenario con Candy66, Desorden Público, Caramelos de Cianuro, Malanga y Stake, con presentaciones en otros estados.", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "con diversos toques y buena aceptación del publico llegan a tocar con bandas como: Candy66, Desorden Público, Caramelos de Cianuro, Malanga, Stake entre otros así como presentaciones en otros estados."}, {"dato": "Alineación: Leonel Carrasquero (voz), José Vicente Daboin (guitarra), Gabriel Arredondo (bajo) y Luis Vásquez (batería); sus integrantes se encuentran fuera del país sin proyectos musicales.", "url": "https://www.youtube.com/watch?v=2qAbwVvfOec", "cita": "Integrantes: \r\nVoz: Leonel Carrasquero\r\nGuitarra: José Vicente Daboin\r\nBajo: Gabriel Arredondo (pin)\r\nBatería: Luis Vásquez"}]}
