{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=t10rNsX-y5Y", "cita": "Funky C (Cristian Moraga -- formerly of popular latin-funk band Los Tetas) lands with his debut album Joya, a NEW latin funk sound"}, {"url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "C-Funk y Funky-C"}, {"url": "https://www.youtube.com/watch?v=qKY0JhanGzQ", "cita": "07. Funky C - Chocolate 21:30"}], "pais": {"valor": "Chile", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Santiago de Chile (Chile)"}, "ciudad": {"valor": "Santiago", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Cristian Sol Moraga Farías (Santiago, 2 de mayo de 1977), más conocido como C-Funk"}, "año_formacion": {"valor": 1992, "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "En 1992, conoció al bajista David Eidelstein, con quien fundó una banda de música funk llamado originalmente «Dr. Funkestein»."}, "generos": [{"genero": "Funk rock", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Funk rock"}, {"genero": "Rap rock", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Rap rock"}, {"genero": "Soul", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Soul"}, {"genero": "Hip hop", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Hip hop"}, {"genero": "Latin funk", "url": "https://www.youtube.com/watch?v=t10rNsX-y5Y", "cita": "a NEW latin funk sound, combining modern hip hop production with classic funk riffs"}], "datos_para_biografia": [{"dato": "Su nombre real es Cristián Sol Moraga Farías y nació en Santiago el 2 de mayo de 1977.", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "Cristian Sol Moraga Farías (Santiago, 2 de mayo de 1977), más conocido como C-Funk"}, {"dato": "Fue líder de la banda chilena de funk Los Tetas y guitarrista de Chancho en Piedra entre 2018 y 2023.", "url": "https://es.wikipedia.org/wiki/C-Funk", "cita": "chileno conocido como uno de los líderes de la agrupación Los Tetas y guitarrista de Chancho en Piedra entre 2018 y 2023"}, {"dato": "Su álbum debut solista, Joya, es latin funk y cuenta con invitados como Dante Spinetta, Julio Briceño (Los Amigos Invisibles) y su padre, Hugo Moraga.", "url": "https://www.youtube.com/watch?v=t10rNsX-y5Y", "cita": "Joined by a parade of Latin guest stars including Dante Spinetta (from the famous Latin funk group Illya Kuriyaki), Julio Briceño (from Venezuela's gosadera superstars Los Amigos Invisibles), and his very own father -- Hugo Moraga"}]}
