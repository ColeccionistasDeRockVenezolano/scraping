{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "La Fe Perdida es un grupo formado en 1968 por Frank Quintero (batería, voz), Leo Quintero (guitarra), Iván Velásquez (batería), Pedro Chacón (bajo) y Álvaro Cordero (teclados)."}, {"url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "En CD sólo se tienen editados los temas Una sombra en tu puerta aparecido en el recopilatorio La Otra Magia de los 60 & 70 (1996), Feeling y Lady Lola los cuales forman parte del box set de Frank Quintero titulado Horas de Vuelo (2009)."}, {"url": "https://www.lobotoradio.com/discos/una-sombra-en-tu-puerta/", "cita": "UNA SOMBRA EN TU PUERTA ... La Fe Perdida ... 03:09 Sencillo · vinilo · 45 RPM · 7 in ... Venezuela (1970) ... Souvenir ... Pop/rock"}, {"url": "https://www.youtube.com/watch?v=8q8LOHICNa0", "cita": "La Fe Perdida - Lady Lola [1971 Latin Heavy Psych Venezuela ]"}], "pais": {"valor": "Venezuela", "url": "https://www.lobotoradio.com/discos/una-sombra-en-tu-puerta/", "cita": "Venezuela (1970)"}, "ciudad": null, "año_formacion": {"valor": 1968, "url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "La Fe Perdida es un grupo formado en 1968 por Frank Quintero (batería, voz), Leo Quintero (guitarra), Iván Velásquez (batería), Pedro Chacón (bajo) y Álvaro Cordero (teclados)."}, "generos": [{"genero": "Pop/rock", "url": "https://www.lobotoradio.com/discos/una-sombra-en-tu-puerta/", "cita": "Pop/rock"}, {"genero": "rock, jazz y soul", "url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "Su sonido era una mezcla de rock, jazz y soul."}], "datos_para_biografia": [{"dato": "Frank Quintero, baterista y vocalista de la banda, continuó con una exitosa carrera como solista y con Frank Quintero & Los Balzehaguaos.", "url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "Frank Quintero tuvo una exitosa carrera con la agrupación Frank Quintero & Los Balzeaguaos y como solista."}, {"dato": "El baterista Iván Velásquez pasó a tocar con La Ofrenda de Vytas Brenner.", "url": "https://rockhechovenezuela.com/f/fe-perdida-la/", "cita": "Iván Velásquez fue baterista de la agrupación La Ofrenda de Vytas Brenner."}, {"dato": "Su obra discográfica se limita a una serie de sencillos de 45 rpm editados por el sello Souvenir entre 1970 y 1971.", "url": "https://www.lobotoradio.com/discos/una-sombra-en-tu-puerta/", "cita": "Una sombra en tu puerta ... 1970 ... Feelin / Lady Lola ... 1971 ... Las escaleras de tu mente / Camino de piedras ... 1971 ... Time passing by my window / Eleanor Rigby ... 1971"}]}
