{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/release/818661a9-d474-4577-92f7-cf715124000c", "cita": "9\tCut Raw\tZardonic, Memtrix, Cooh and No Money"}, {"url": "https://musicbrainz.org/artist/b2a57736-3cdd-4dac-afef-ba6f8a9270cd", "cita": "Performance name of: Ivan Shopov"}, {"url": "https://www.ivanshopov.com/projects/cooh/", "cita": "Cooh is the drum and bass alias with which Ivan has released tracks for several prominent international drum and bass labels Position Chrome, PRSPCT Recordings, L/B, Algorithm and has performed in events all across the world including many Therapy Sessions events as a headliner."}], "pais": {"valor": "Bulgaria", "url": "https://musicbrainz.org/artist/b2a57736-3cdd-4dac-afef-ba6f8a9270cd", "cita": "Type: Person / Gender: Male / Area: Bulgaria"}, "ciudad": {"valor": "Sofia", "url": "https://soundcloud.com/cooh", "cita": "Graduated an MA in print making from The National Academy of Arts in Sofia, he’s the author of numerous ink and acrylic pieces."}, "año_formacion": null, "generos": [{"genero": "drum and bass", "url": "https://musicbrainz.org/artist/b2a57736-3cdd-4dac-afef-ba6f8a9270cd", "cita": "drum and bass, darkstep"}, {"genero": "darkstep", "url": "https://musicbrainz.org/artist/b2a57736-3cdd-4dac-afef-ba6f8a9270cd", "cita": "drum and bass, darkstep"}, {"genero": "Hardcore", "url": "https://www.ivanshopov.com/projects/cooh/", "cita": "Drum & Bass / Hardcore / Industrial"}], "datos_para_biografia": [{"dato": "Cooh es el alias de drum and bass de Ivan Shopov; ha publicado en sellos como Position Chrome, PRSPCT Recordings, L/B y Algorithm.", "url": "https://www.ivanshopov.com/projects/cooh/", "cita": "Cooh is the drum and bass alias with which Ivan has released tracks for several prominent international drum and bass labels Position Chrome, PRSPCT Recordings, L/B, Algorithm and has performed in events all across the world including many Therapy Sessions events as a headliner."}, {"dato": "Acumula más de 120 lanzamientos en vinilo.", "url": "https://www.ivanshopov.com/projects/cooh/", "cita": "With more than 120 vinyl releases behind his back, he is one of the hardest working producers on the scene."}, {"dato": "Ha participado en más de 250 lanzamientos musicales y publica parte de su obra en sus sellos Etheraudio Records y ABCD.", "url": "https://soundcloud.com/cooh", "cita": "Ivan Shopov has been involved in over 250 musical releases, among which we find both solo and collaborative albums. This has established him as one of the leading figures in the European electronic underground."}]}
