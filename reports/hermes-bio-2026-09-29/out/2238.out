{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=QDIX_z5lImw", "cita": "01. Sin Salida - Instinto 00:00"}, {"url": "https://www.facebook.com/coleccionistasderockvenezolano/posts/memoriarock-a%C3%B1o-1998-sonicosubte-un-compilado-de-bandas-de-san-antonio-de-los-al/1903342313233391/", "cita": "\"Sonicosubte\", un compilado de bandas de San Antonio De Los Altos, Miranda, Venezuela es publicado con bandas como Hora Cero, El Pendulo, Sin Salida, Kinder Toten y Don Seruyo."}, {"url": "https://horacero.bandcamp.com/album/sonicosubte", "cita": "Primer disco grabado por varias bandas donde se recopila lo mejor del rock sanantoñero para 1998."}], "pais": {"valor": "Venezuela", "url": "https://www.facebook.com/coleccionistasderockvenezolano/posts/memoriarock-a%C3%B1o-1998-sonicosubte-un-compilado-de-bandas-de-san-antonio-de-los-al/1903342313233391/", "cita": "un compilado de bandas de San Antonio De Los Altos, Miranda, Venezuela"}, "ciudad": {"valor": "San Antonio de los Altos", "url": "https://www.facebook.com/coleccionistasderockvenezolano/posts/memoriarock-a%C3%B1o-1998-sonicosubte-un-compilado-de-bandas-de-san-antonio-de-los-al/1903342313233391/", "cita": "un compilado de bandas de San Antonio De Los Altos, Miranda, Venezuela"}, "año_formacion": null, "generos": [{"genero": "rock", "url": "https://horacero.bandcamp.com/album/sonicosubte", "cita": "se recopila lo mejor del rock sanantoñero para 1998"}], "datos_para_biografia": [{"dato": "Formación de Sin Salida según los créditos del compilado: Victor Chapela (voz y guitarra), Alejandro Galicia (guitarra y coros), Richard Riobueno (bajo) y Leonardo Angúlo (batería).", "url": "https://www.youtube.com/watch?v=QDIX_z5lImw", "cita": "Sin Salida (tracks 01, 10)\n\nLead Vocals & Guitar: Victor Chapela\nGuitar & Backing vocals: Alejandro Galicia\nBass: Richard Riobueno\nDrums: Leonardo Angúlo"}, {"dato": "Sonicosubte fue lanzado el 20 de noviembre de 1998.", "url": "https://horacero.bandcamp.com/album/sonicosubte", "cita": "se lanzó el 20denoviembrede1998"}, {"dato": "El compilado fue producido por Produciones De La Montaña y grabado y mezclado por Marcelo Sanhueza.", "url": "https://www.youtube.com/watch?v=QDIX_z5lImw", "cita": "Produced by Produciones De La Montaña\nRecorded & Mixed by Marcelo Sanhueza"}]}
