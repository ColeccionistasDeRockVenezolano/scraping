{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "Fulerious is an Experimental Post Rock band from Acarigua, Venezuela"}, {"url": "https://trascendencia.rocks/metalkinesia-capitulo-portuguesa/", "cita": "10. FULERIOUS – Collateral 4:43"}, {"url": "https://www.facebook.com/Fulerious/", "cita": "Fulerious. 848 seguidores. www.fulerious.com.ve\n\nSer libre no es hacer lo que uno quiere, sino querer lo que se hace."}], "pais": {"valor": "Venezuela", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "Fulerious is an Experimental Post Rock band from Acarigua, Venezuela"}, "ciudad": {"valor": "Acarigua", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "Fulerious is an Experimental Post Rock band from Acarigua, Venezuela"}, "año_formacion": null, "generos": [{"genero": "Experimental Post Rock", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "Fulerious is an Experimental Post Rock band from Acarigua, Venezuela"}, {"genero": "post-rock", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "post-rock"}, {"genero": "progressive metal", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "progressive metal"}, {"genero": "Rock Experimental", "url": "https://paltoque.com/concierto-fulerious-y-caribe-acarigua-5-de-septiembre/", "cita": "– Fulerious (Acarigua) – Rock Experimental"}], "datos_para_biografia": [{"dato": "Su álbum se titula P A L M E N y fue lanzado el 11 de marzo de 2016; producido por Fulerious, grabado en Lala Estudio y mezclado/masterizado por Orlando Barranco.", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "se lanzó el 11demarzode2016\n\nProduced by Fulerious\n\nRecorded in Lala Estudio\n\nMix and Mastered by Orlando Barranco"}, {"dato": "«Collateral» es la pista 10 de su álbum P A L M E N y con ella participó en el recopilatorio venezolano Metalkinesia – Capítulo Portuguesa (edición Nro. 16, 2020).", "url": "https://trascendencia.rocks/metalkinesia-capitulo-portuguesa/", "cita": "Edición Nro. 16 de este recopilatorio musical metal venezolano. ... 10. FULERIOUS – Collateral 4:43"}, {"dato": "Concepto argumental del álbum P A L M E N, sobre un ser de infancia común que termina corrompido.", "url": "https://fulerious.bandcamp.com/album/p-a-l-m-e-n", "cita": "A being with a common childhood and innocent dreams, whose life throughout its existence had a series of good and bad experiences. Ultimately, he became corrupt... In the end no goodness stayed within it..."}]}
