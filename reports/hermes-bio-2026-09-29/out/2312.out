{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=NhyRiO58dSI", "cita": "05. FRANK  MORÓN - Blues  3:48"}, {"url": "https://metallethal.com.ve/metalkinesia/capitulo-trujillo.html", "cita": "05.\tFRANK MORO\tBlues\t3:48"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "05. FRANK MORO - Blues 3:48 ... Lugar: Trujillo - Venezuela"}, {"url": "https://soundcloud.com/frankmoron", "cita": "FRANKMORON, nacido en Trujillo. desde temprana edad demostró grandiosas cualidades musicales, su primer instrumento fue el cuatro, el cual fué el trampolín para su pasión por las guitarras las que colecciona y quiere como parte de su familia.\nYa en Puerto Ordaz, su trayectoria musical le permitió entre varias actividades ser profesor de música ... Podríamos definir a NADA QUE DECIR como una exaltación del clásico rock, blues, rithym and blues."}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/@FrankMoronMusic/about", "cita": "www.youtube.com/@FrankMoronMusic\n\nVenezuela\n\nSe unió el 28 jul 2008"}, "ciudad": {"valor": "Trujillo", "url": "https://soundcloud.com/frankmoron", "cita": "FRANKMORON, nacido en Trujillo."}, "año_formacion": null, "generos": [{"genero": "Rock", "url": "https://soundcloud.com/frankmoron", "cita": "Podríamos definir a NADA QUE DECIR como una exaltación del clásico rock, blues, rithym and blues."}, {"genero": "Blues", "url": "https://soundcloud.com/frankmoron", "cita": "Podríamos definir a NADA QUE DECIR como una exaltación del clásico rock, blues, rithym and blues."}, {"genero": "Folk / Pop-rock independiente", "url": "https://www.youtube.com/@FrankMoronMusic/about", "cita": "mi música es un viaje entre el folk de mi tierra, el pop-rock independiente y el sabroso ritmo del raspacanilla"}, {"genero": "Acústico / Rhythm & Blues", "url": "https://soundcloud.com/frankmoron", "cita": "Podríamos definir a NADA QUE DECIR como una exaltación del clásico rock, blues, rithym and blues."}], "datos_para_biografia": [{"dato": "Nacido en Trujillo; su primer instrumento fue el cuatro y colecciona guitarras.", "url": "https://soundcloud.com/frankmoron", "cita": "FRANKMORON, nacido en Trujillo. desde temprana edad demostró grandiosas cualidades musicales, su primer instrumento fue el cuatro, el cual fué el trampolín para su pasión por las guitarras las que colecciona y quiere como parte de su familia."}, {"dato": "Su primera producción discográfica es «Nada Que Decir» (rock/blues), grabada en Lecherías, Venezuela y masterizada en Londres.", "url": "https://soundcloud.com/frankmoron", "cita": "NADA QUE DECIR es el resultado de dos años de fantástica aventura musical ... Grabado y mezclado en BronwBunkerStudio y 311 Studio, Lecherías, Venezuela por Eduardo López, Alfred Gómez Jr. Masterizado en IK Studios, Londres UK por Doug Shearer."}, {"dato": "Cantautor activo con el disco «Postales» (tema La Noche Nos Supera) y colaboraciones con Bostonrex.", "url": "https://www.youtube.com/@FrankMoronMusic/about", "cita": "Soy Frank Morón, cantautor ... Aquí encontrarás desde colaboraciones a dos manos con hermanos como Bostonrex (Tu farsa, Noches de luna llena), hasta experimentos electrónicos como Natural o mi versión gypsy-afro de Sabor a mí."}]}
