{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/release/31d438d2-c0c7-4fbb-a8a5-486060735e9e", "cita": "2 Play the Game / Juégale, apuéstale ... cover recording of: Play the Game ... Aterciopelados ... 2:54"}, {"url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "Aterciopelados (English: Velvety Ones), also known as Los Aterciopelados, is a rock band from Colombia, led by Andrea Echeverri and Héctor Buitrago."}], "pais": {"valor": "Colombia", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "Area: Colombia"}, "ciudad": {"valor": "Bogotá", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "Founded in: Bogotá, Colombia"}, "año_formacion": {"valor": 1992, "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "Founded: 1992 (34 years ago)"}, "generos": [{"genero": "rock", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "rock, alternative rock, latin"}, {"genero": "alternative rock", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "rock, alternative rock, latin"}, {"genero": "latin", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "rock, alternative rock, latin"}], "datos_para_biografia": [{"dato": "Banda liderada por Andrea Echeverri y Héctor Buitrago", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "is a rock band from Colombia, led by Andrea Echeverri and Héctor Buitrago"}, {"dato": "Ganadores de cuatro premios Latin Grammy de ocho nominaciones, incluido Mejor Álbum Alternativo en 2007 por Oye", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "The group has won four Latin Grammy Awards from eight nominations, including Best Alternative Album in 2007 for Oye, as well as four Grammy Award nominations."}, {"dato": "Ya tenían discografía propia antes del tributo, como el álbum La pipa de la paz (1996)", "url": "https://musicbrainz.org/artist/0ba1966a-e471-4f98-85d7-8ac0c1f836f0", "cita": "1996 La pipa de la paz Aterciopelados"}]}
