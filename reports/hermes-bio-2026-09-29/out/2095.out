{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/search?q=Mystica", "cita": "Banda: Maracaibo Álbum: El Delicado Sonido del Rock - Volumen III ... 29. Mystica - La Casa de los Niños ... Lugar: Maracaibo - Venezuela"}, {"url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "El track list de “Antes Del Palacio” está compuesto por: 01. Antes Del Palacio, 02. Alucinación Real, 03. La Casa De Los Niños, 04. Aferrado A Un Astro"}, {"url": "https://soundcloud.com/mistyca-zulia", "cita": "Mystica \"Antes Del Palacio\" (2017): 1. Antes Del Palacio 2. Alucinación Real 3. La Casa De Los Niños"}], "pais": {"valor": "Venezuela", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "«Antes Del Palacio» es nuestro lanzamiento artístico de Rock sinfónico, heavy metal y dosis de otros géneros en español. Desde Maracaibo – Venezuela”."}, "ciudad": {"valor": "Maracaibo", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "Mystica, agrupación proveniente de Maracaibo – Estado Zulia, nos traen su primer trabajo discográfico de nombre “Antes Del Palacio”"}, "año_formacion": null, "generos": [{"genero": "Heavy Metal", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "es un disco enmarcado dentro de un estilo influenciado por el Heavy Metal y en donde se integran diversos elementos de características más dirigidas hacia el rock sinfónico"}, {"genero": "Rock sinfónico", "url": "https://soundcloud.com/mistyca-zulia", "cita": "\"Antes Del Palacio\" es nuestra 1era produccion discografica de Rock sinfónico, heavy metal y dosis de otros géneros"}], "datos_para_biografia": [{"dato": "Primer disco «Antes Del Palacio» (2017), 12 canciones escritas por José Alberto González a finales de 2017", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "El disco contiene por lo menos 12 canciones que fueron escritas por José Alberto González a finales de 2017."}, {"dato": "Integrantes: Roaldis Ávila y Andrea Linares (voces), César González (guitarras), José Alberto González (teclado, secuencias y coros), Miguel De Donato (bajo), Miguel Hernández (batería)", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "Actualmente Mistyca está conformado por: Roaldis Ávila y Andrea Linares (Voces), César González (Guitarras), José Alberto González (Teclado, Secuencias y Coros) Miguel De Donato (Bajo), Miguel Hernández (Batería)."}, {"dato": "Grabado en Probos Estudio Creativo (2017), editado/mezclado/masterizado por Miguel De Donato; arte por Jehosafath Nava", "url": "https://cerebrosexprimidos.com.ve/mystica/", "cita": "El disco fue grabado en grabado en Probos Estudio Creativo (2017). Editado, mezclado y masterizado por Miguel De Donato y la creación de diseño artístico y conceptual fue responsabilidad de Jehosafath Nava."}]}
