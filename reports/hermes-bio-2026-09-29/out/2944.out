{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://api.discogs.com/releases/4288397", "cita": "{\"id\":4288397,...,\"title\":\"Twist Y Crimen\",\"country\":\"Venezuela\",\"released\":\"1963\",\"labels\":[{\"name\":\"Discomoda\",\"catno\":\"DCM 322\",...}],\"tracklist\":[...,{\"position\":\"B2\",\"type_\":\"track\",\"artists\":[{\"name\":\"Orquesta Sinfónica De Venezuela\",\"anv\":\"Orq. Sinfonia Venezuela\",...\"id\":5986954,...}],\"title\":\"Suite Mediodia En El Llano\",\"extraartists\":[{\"name\":\"Antonio Estévez\",...\"role\":\"Conductor\",...}]},...]}"}, {"url": "https://api.discogs.com/artists/5986954", "cita": "{\"name\":\"Orquesta Sinfónica De Venezuela\",\"id\":5986954,...,\"profile\":\"Venezuelan symphonic orchestra (also known as OSV) created in 1930 (with their first concert the 24 June 1930) in Caracas by [a894378] and [a7445791], and is, after the Boston Symphony Orchestra, the oldest orchestra in the American continent..."}, {"url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "La Orquesta Sinfónica Venezuela (conocida también como Orquesta Sinfónica de Venezuela y OSV) es una de las orquestas más importantes de Venezuela."}], "pais": {"valor": "Venezuela", "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "La Orquesta Sinfónica Venezuela (conocida también como Orquesta Sinfónica de Venezuela y OSV) es una de las orquestas más importantes de Venezuela."}, "ciudad": {"valor": "Caracas", "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "Caracas, Venezuela"}, "año_formacion": {"valor": 1930, "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "Fue fundada por Vicente Emilio Sojo el 24 de junio de 1930"}, "generos": [{"genero": "Música clásica", "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "Música clásica"}], "datos_para_biografia": [{"dato": "Es, después de la Orquesta Sinfónica de Boston, la orquesta más antigua del continente americano.", "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "Fue fundada por Vicente Emilio Sojo el 24 de junio de 1930 y es, después de la Orquesta Sinfónica de Boston, la orquesta más antigua del continente americano."}, {"dato": "Uno de sus directores titulares fue Antonio Estévez, director del tema «Suite Mediodia En El Llano» en el disco.", "url": "https://api.discogs.com/artists/5986954", "cita": "Titular conductors have been Vicente Emilio Sojo, Vicente Martucci, Ángel Sauce, Antonio Estévez, Gonzalo Castellanos Yumar, Georg Schmöhe, Eduardo Marturet, Theodore Kuchar."}, {"dato": "Su sede actual es el Teatro Teresa Carreño, en Caracas.", "url": "https://es.wikipedia.org/wiki/Orquesta_Sinfónica_Venezuela", "cita": "Su sede actual está en el Teatro Teresa Carreño."}]}
