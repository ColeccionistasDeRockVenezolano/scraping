{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2019/10/metalkinesia-capitulo-migracion-2019.html", "cita": "23. Piel de Lobo (Argentina) - Plomo 4:23"}, {"url": "https://pieldelobooficial.wixsite.com/pieldelobo", "cita": "Piel de Lobo - P.L.O.M.O. [OFFICIAL MUSIC VIDEO]"}, {"url": "https://www.youtube.com/@pieldelobo", "cita": "Piel de Lobo - P.L.O.M.O. [OFFICIAL MUSIC VIDEO]"}], "pais": {"valor": "Argentina", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "il cui primo numero è dedicato ai Piel De Lobo, band argentina dal grande potenziale"}, "ciudad": {"valor": "Córdoba", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "I Piel De Lobo (trad. Pelle Di Lupo), nati a Còrdoba in Argentina"}, "año_formacion": {"valor": 2019, "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "sembra aver trovato pace a partire dal 2019, anno in cui i Piel De Lobo iniziano a realizzare i primi videoclip e a partecipare a importanti eventi di musica dal vivo"}, "generos": [{"genero": "Metal Latino", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "Lo stesso Gerardo Torres ritiene che la sua creazione non appartenga a nessuna corrente di Metal tradizionale, definendo Metal Latino lo stile dei Piel De Lobo"}, {"genero": "Metal con música folk venezolana y ritmos afrocaraibici", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "proseguendo la strada delle contaminazioni tra Metal, musica folk venezuelana e ritmi afrocaraibici"}, {"genero": "metal con ritmos afro-venezolanos", "url": "https://www.youtube.com/@pieldelobo", "cita": "Combinando metal con ritmos afro-venezolanos como de costumbre"}], "datos_para_biografia": [{"dato": "Proyecto liderado por el cantante venezolano Gerardo Torres, activo desde los años 90 en Venezuela y radicado en Argentina tras un breve paso por Uruguay", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "del venezuelano Gerardo Torres, cantante attivo sin dagli anni ’90 in Venezuela e trasferitosi stabilmente in Argentina dopo un breve passaggio in Uruguay"}, {"dato": "Nace como heredera de la banda venezolana Màquina (originaria de Mérida), disuelta en 2016 tras producir su primer CD «Cuando Las Madres Rezan», con Ray Lara como cofundador", "url": "https://www.truemetal.it/articoli/are-you-experienced-piel-de-lobo", "cita": "I Màquina , originari di Mèrida, nel 2006 danno alle stampe l’EP “Buscando la Raìz” per poi approdare nel 2016, anno del loro scioglimento, alla produzione del primo CD, “Cuando Las Madres Rezan”"}, {"dato": "Formada por músicos venezolanos y argentinos radicados en Córdoba", "url": "https://www.youtube.com/@pieldelobo", "cita": "La banda conformada por Músicos Venezolanos y Argentinos Piel de Lobo radicados en Córdoba, presentaron el primer single \"Amuletos de Tumba\""}]}
