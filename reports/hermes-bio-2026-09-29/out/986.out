{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/playlist?list=PLHo4VKdIa0sQbKrUycBiIe_ikkoqEplPy", "cita": "Turbo Hits — 07  Jump   VAN HALEN (1984)"}, {"url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "The album 1984, released in January 1984, was a commercial success with, by February 1999, U.S. sales of 10 million copies and four successful singles. Its lead single, \"Jump\", was the band's only number-one single"}], "pais": {"valor": "Estados Unidos", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Pasadena, California, U.S."}, "ciudad": {"valor": "Pasadena, California", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "was an American rock band formed in Pasadena, California, in 1972."}, "año_formacion": {"valor": 1972, "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "was an American rock band formed in Pasadena, California, in 1972."}, "generos": [{"genero": "hard rock", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Credited with restoring hard rock to the forefront of the music scene"}, {"genero": "heavy metal", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Hard rock· heavy metal· pop rock· glam metal"}, {"genero": "pop rock", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Hard rock· heavy metal· pop rock· glam metal"}, {"genero": "glam metal", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Hard rock· heavy metal· pop rock· glam metal"}], "datos_para_biografia": [{"dato": "Banda estadounidense de rock formada en Pasadena, California, en 1972; célebre por sus enérgicas presentaciones en vivo y la virtuosidad de su guitarrista Eddie Van Halen.", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "was an American rock band formed in Pasadena, California, in 1972. Credited with restoring hard rock to the forefront of the music scene, Van Halen was known for their energetic live performances and the virtuosity of their guitarist, Eddie Van Halen."}, {"dato": "Su álbum 1984 (enero de 1984) fue un éxito comercial con 10 millones de copias vendidas en EE. UU. y el sencillo \"Jump\" como único número uno de la banda.", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "The album 1984, released in January 1984, was a commercial success with, by February 1999, U.S. sales of 10 million copies and four successful singles. Its lead single, \"Jump\", was the band's only number-one single"}, {"dato": "También conocida al inicio como Genesis y Mammoth; años activos 1972–1999 y 2003–2020.", "url": "https://en.wikipedia.org/wiki/Van_Halen", "cita": "Genesis· Mammoth (early)"}]}
