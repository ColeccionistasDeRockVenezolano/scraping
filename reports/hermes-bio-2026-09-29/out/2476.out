{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=qKdJ0sxTt9I", "cita": "12. Los Pericos - Darkness 50:02"}, {"url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "They also participated in the Latin tribute to The Police Outlandos D'Americas: Tributo a Police, performing a Spanish-language version of the same song, titled \"Oscuridad\"."}], "pais": {"valor": "Argentina", "url": "https://es.wikipedia.org/wiki/Los_Pericos", "cita": "Los Pericos es una banda de reggae y ska argentina fundada en 1986."}, "ciudad": {"valor": "Buenos Aires", "url": "https://es.wikipedia.org/wiki/Los_Pericos", "cita": "Origen: Buenos Aires, Argentina"}, "año_formacion": {"valor": 1987, "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "Los Pericos is an Argentine band formed in 1987."}, "generos": [{"genero": "Reggae", "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "Genres: Reggae, ska, rock"}, {"genero": "Ska", "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "Genres: Reggae, ska, rock"}, {"genero": "Rock", "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "Genres: Reggae, ska, rock"}, {"genero": "Reggae", "url": "https://musicbrainz.org/artist/fe50841b-f14b-4882-a4be-38a04f69374b", "cita": "Tags / Genres: reggae"}], "datos_para_biografia": [{"dato": "Fue la única banda latinoamericana invitada al tributo reggae a The Police y grabó «Darkness» junto a Stewart Copeland.", "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "In March 1997, Los Pericos was the only Latin American band invited to participate in the reggae tribute to The Police and recorded together with Stewart Copeland, the track \"Darkness\"."}, {"dato": "En 1996 interpretó «Wanna Be Loved (Desea ser Amado)» para el disco benéfico contra el sida Silencio=Muerte: Red Hot + Latin, producido por la Red Hot Organization con Buju Banton.", "url": "https://en.wikipedia.org/wiki/Los_Pericos", "cita": "In 1996, the band performed \"Wanna Be Loved (Desea ser Amado)\" for the AIDS benefit album, Silencio=Muerte: Red Hot + Latin, produced by the Red Hot Organization with Buju Banton."}, {"dato": "En 2006 había superado los dos millones y medio de discos vendidos y más de tres mil presentaciones en vivo.", "url": "https://es.wikipedia.org/wiki/Los_Pericos", "cita": "En 2006 había superado los dos millones y medio de discos vendidos y más de tres mil presentaciones en vivo."}]}
