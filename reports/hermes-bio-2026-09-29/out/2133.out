{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "Los termites graban 12 temas que en años 2015 son recuperados por el baterista Ricardo Adrianza y publicados en la plataforma Youtube, los cuales son:"}, {"url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "Los Termites Lucille"}, {"url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "Este grupo lo denominamos “THE TERMITES” y el cual duro solamente dos veranos."}], "pais": null, "ciudad": {"valor": "Maracaibo", "url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "me propusiero constituir un grupo para tocar en las fiestas de los Club Americanos, tanto en la Costa Oriental, como en Maracaibo."}, "año_formacion": null, "generos": [{"genero": "Rock", "url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "La historia del rock Zuliano"}], "datos_para_biografia": [{"dato": "The Termites grabó 12 temas que fueron recuperados en 2015 por el baterista Ricardo Adrianza y publicados en YouTube", "url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "Los termites graban 12 temas que en años 2015 son recuperados por el baterista Ricardo Adrianza y publicados en la plataforma Youtube"}, {"dato": "Integrantes: Kenny Pérez y Danny Neal (guitarras), Frankie Neal, Ricardo Alcalá (bajo) y Ricardo J. Adrianza (batería)", "url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "se me acercaron Kenny Perez y Danny Neal, quienes conjuntamente con Frankie Neal tocaban en un conjunto en Orlando-Florida donde estudiaban y me propusiero constituir un grupo para tocar en las fiestas de los Club Americanos, tanto en la Costa Oriental, como en Maracaibo. Recuerdo haber tocado en el Club de Tia Juana, Club Nautico, Creole y otros . A este se nos unio Ricardo Alcala, quien tocaba el bajo."}, {"dato": "Grupo formado para tocar en las fiestas de los clubes de la Costa Oriental y Maracaibo; duró solo dos veranos y en él se originó a partir de los miembros de Los Luggers y estudiantes del Colegio Alemán del Zulia", "url": "https://www.facebook.com/notes/la-historia-del-rock-zuliano/los-luggers-the-termites-y-los-jensen-1963/1800368606867859/", "cita": "Estudiando estudiando en el Colegio Aleman del Zulia y despues de haber visto y compartido con los grupos locales de la epoca"}]}
