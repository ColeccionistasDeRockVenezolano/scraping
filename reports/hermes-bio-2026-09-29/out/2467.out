{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=6WxkhlUKop0", "cita": "Sus integrantes Héctor Di Donna, Gustavo Merchán, Bernardo Montoto, Ricardo Rojas y Simón Alvarez graban como único legado discográfico un sencillo con los temas \"Dama Gentil\" y \"Hombre de Paz\""}, {"url": "https://www.youtube.com/watch?v=TvM6mK2CUiQ", "cita": "\"DAMA GENTIL\" también conocido como LA DAMA DE LA ISLA es un tema grabado por el Grupo ESPIGA en 1972, en Caracas Venezuela"}, {"url": "https://munsterrecords.bandcamp.com/album/joropop", "cita": "DAMA GENTIL – GRUPO ESPIGA"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=TvM6mK2CUiQ", "cita": "es un tema grabado por el Grupo ESPIGA en 1972, en Caracas Venezuela"}, "ciudad": {"valor": "Caracas", "url": "https://www.youtube.com/watch?v=6WxkhlUKop0", "cita": "Banda de rock surgida en Caracas en 1971."}, "año_formacion": {"valor": 1971, "url": "https://www.youtube.com/watch?v=6WxkhlUKop0", "cita": "Banda de rock surgida en Caracas en 1971."}, "generos": [{"genero": "rock", "url": "https://www.youtube.com/watch?v=6WxkhlUKop0", "cita": "Banda de rock surgida en Caracas en 1971."}, {"genero": "psych pop & folk", "url": "https://munsterrecords.bandcamp.com/album/joropop", "cita": "“Joropop. Psych Pop & Folk in Venezuela, 1968-1976” está repleto de contagiosos ritmos de rock latino y folk de melodías inmortales a lo largo de sus 15 cortes de grabaciones ultra raras"}], "datos_para_biografia": [{"dato": "Formación original: Héctor Di Donna (teclados, guitarra y voz), Gustavo Merchán (flauta, voz y guitarra), Bernardo Montoto (guitarra y voz), Ricardo Rojas (bajo y voz) y Simón Álvarez (batería); grabaron un único sencillo con \"Dama Gentil\" y \"Hombre de Paz\".", "url": "https://www.youtube.com/watch?v=6WxkhlUKop0", "cita": "Banda de rock surgida en Caracas en 1971. Producida por Mario Tepedino. Sus integrantes Héctor Di Donna, Gustavo Merchán, Bernardo Montoto, Ricardo Rojas y Simón Alvarez graban como único legado discográfico un sencillo con los temas \"Dama Gentil\" y \"Hombre de Paz\""}, {"dato": "Producidos por Mario Tepedino y grabados en Estudios del Este (Caracas, 1972).", "url": "https://www.youtube.com/watch?v=TvM6mK2CUiQ", "cita": "Fue un grupo muy activo en la escena del ROCK de Venezuela, con COMPOSICIONES PROPIAS como el tema de este video, participaron en varios festivales de la época..."}, {"dato": "Influidos por Crosby, Stills, Nash & Young, Blind Faith y The Beatles; \"Dama Gentil\" fue una creación colectiva del grupo.", "url": "https://www.youtube.com/watch?v=TvM6mK2CUiQ", "cita": "fueron influidos por CROSBY, STILL, NASH & YOUNG, BLIND FAITH, BEATLES ..., \"DAMA GENTIL\", fue una creación colectiva de los integrantes del grupo"}]}
