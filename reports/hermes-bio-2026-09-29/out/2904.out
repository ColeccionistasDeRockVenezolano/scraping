{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/ws/2/recording?query=recording:%22Extreme%20Steel%22&fmt=json&limit=25", "cita": "\"title\":\"Extreme Steel (Counterstrike Arena remix)\",\"length\":414000,\"video\":null,\"artist-credit\":[{\"name\":\"KC\",\"artist\":{\"id\":\"020a1c78-3b1b-49e0-9f9d-8a020120816e\",\"name\":\"KC\",\"sort-name\":\"KC\",\"disambiguation\":\"US drum & bass/techno producer Kevin Cunningham\""}, {"url": "https://musicbrainz.org/artist/020a1c78-3b1b-49e0-9f9d-8a020120816e", "cita": "KC (US drum & bass/techno producer Kevin Cunningham)"}, {"url": "https://api.discogs.com/artists/7827", "cita": "{\"id\":360824,\"title\":\"Extreme Steel EP\",\"type\":\"master\",\"main_release\":242619,\"artist\":\"KC\",\"role\":\"Main\",\"resource_url\":\"https://api.discogs.com/masters/360824\",\"year\":2004"}], "pais": {"valor": "United States", "url": "https://musicbrainz.org/artist/020a1c78-3b1b-49e0-9f9d-8a020120816e", "cita": "Area: United States"}, "ciudad": {"valor": "Cleveland", "url": "https://api.discogs.com/artists/7827", "cita": "Drum & Bass and techno producer from Cleveland, Ohio."}, "año_formacion": null, "generos": [{"genero": "Drum & Bass", "url": "https://api.discogs.com/artists/7827", "cita": "Drum & Bass and techno producer from Cleveland, Ohio."}, {"genero": "Techno", "url": "https://api.discogs.com/artists/7827", "cita": "Drum & Bass and techno producer from Cleveland, Ohio."}], "datos_para_biografia": [{"dato": "Inició su carrera junto al equipo de producción Psychoactive de Steven \"Sleepy C\" Cinch, en Ohio.", "url": "https://api.discogs.com/artists/7827", "cita": "The DJ and production force known as Kevin Cunningham or KC for short, started his career alongside Steven \"Sleepy C\" Cinch’s production crew Psychoactive in Ohio."}, {"dato": "Se trasladó a Chicago y trabajó en la tienda de DJ Supreme Records como jefe de pedidos de drum'n'bass, importando jungle.", "url": "https://api.discogs.com/artists/7827", "cita": "In an effort to gain independence from the local scene, KC migrated to Chicago where he landed a prestigious job in the DJ mega-store, Supreme Records. As head of ordering drumnbass at Supreme, KC served up a selection of import jungle"}, {"dato": "Su primer lanzamiento en el sello CANVAS, «System Overload», fue un éxito inmediato en la escena nacional (EE. UU.).", "url": "https://api.discogs.com/artists/7827", "cita": "KC’s first release on CANVAS, “System Overload,” was an immediate hit on the domestic scene."}]}
