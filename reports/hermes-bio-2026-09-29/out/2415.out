{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "Fekal Vomyt: Degenere metalero de Nicaragua"}, {"url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "En Nicaragua existe una gran cantidad de bandas de metal y algunas se manejan en terrenos más \"underground\", tal es el caso de Fekal Vomyt, quienes profesan un goregrind crudo y directo, ese que les sale desde las venas y pone a la gente en onda rápidamente."}, {"url": "https://soundcloud.com/fekalvomyt/fekal-vomyt-el-feto-me-habla", "cita": "Stream Fekal Vomyt - El Feto Me Habla by Fekal Vomyt"}, {"url": "https://www.youtube.com/watch?v=QF0cdZDuOCw", "cita": "Fekal vomyt - Sindrome de colon tieso"}], "pais": {"valor": "Nicaragua", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "Fekal Vomyt: Degenere metalero de Nicaragua"}, "ciudad": {"valor": "Ciudad Sandino", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "Esta banda tiene varios años de haberse formado, allá en 2007 en Ciudad Sandino"}, "año_formacion": {"valor": 2007, "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "Esta banda tiene varios años de haberse formado, allá en 2007 en Ciudad Sandino"}, "generos": [{"genero": "goregrind", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "quienes profesan un goregrind crudo y directo"}], "datos_para_biografia": [{"dato": "Sus integrantes iniciales fueron Rafael Rocha (voces), Javier Arteaga (guitarra) y Ullyses Hernández (bajo), incorporándose después Francisco Ulloa a la batería.", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "iniciando todo con Rafael Rocha (voces), Javier Arteaga (guitarra) y Ullyses Hernández (bajo)"}, {"dato": "En 2015 se tomaron un año sabático y en 2016 regresaron con Álvaro Carmona al bajo, participando luego en eventos como el Brutal Grinder Fest, el Homenaje al General Sandino y el Homenaje al Che Guevara.", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "En 2015 deciden darse un descanso, algo así como un año sabático, y en 2016 entraron de lleno con una nueva incorporación: Álvaro Carmona tomando el papel del bajo."}, {"dato": "Cuenta con al menos 30 canciones originales, entre ellas «El Feto Me Habla», «Trastorno Anal» y «Síndrome del Colon Tieso».", "url": "https://web.archive.org/web/20251015221252/https://www.tn8.ni/musica/415704-fekal-vomyt-degenere-metalero-nicaragua/", "cita": "Algo que llama muchísimo la atención son los nombres de los temas que tiene esta agrupación, entre ellos El Feto Me Habla , Trastorno Anal o uno que sin duda captó la atención de muchos: Síndrome del Colon Tieso ."}]}
