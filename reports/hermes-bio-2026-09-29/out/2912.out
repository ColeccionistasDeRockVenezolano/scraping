{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/recording/52451e22-8570-4842-a989-f8b1e5465603", "cita": "Dawn Of The Angry (Zardonic remix) — ~Recording by Morbid Angel ... Appears on releases: 1.30 | Dawn Of The Angry (Zardonic remix) | 6:26 | Morbid Angel | Tunes From the Vault! | Zardonic | Album + Remix ... recording of: Dawn of the Angry"}, {"url": "https://musicbrainz.org/artist/4355a36d-805e-478d-8589-64f0292724b2", "cita": "Morbid Angel (Florida death metal) ~ Group ... Founded: 1983 (43 years ago) Founded in: Tampa, Florida, United States Area: United States"}, {"url": "https://en.wikipedia.org/wiki/Morbid_Angel", "cita": "Morbid Angel is an American death metal band based in Tampa, Florida, formed in 1983 by guitarist, primary composer and sole remaining original member Trey Azagthoth, vocalist and bassist Dallas Ward, and drummer Mike Browning."}], "pais": {"valor": "United States", "url": "https://musicbrainz.org/artist/4355a36d-805e-478d-8589-64f0292724b2", "cita": "Area: United States"}, "ciudad": {"valor": "Tampa, Florida", "url": "https://musicbrainz.org/artist/4355a36d-805e-478d-8589-64f0292724b2", "cita": "Founded in: Tampa, Florida, United States"}, "año_formacion": {"valor": 1983, "url": "https://musicbrainz.org/artist/4355a36d-805e-478d-8589-64f0292724b2", "cita": "Founded: 1983 (43 years ago)"}, "generos": [{"genero": "Death metal", "url": "https://en.wikipedia.org/wiki/Morbid_Angel", "cita": "Genre: Death metal"}, {"genero": "death metal", "url": "https://musicbrainz.org/artist/4355a36d-805e-478d-8589-64f0292724b2", "cita": "Tags Genres: death metal, metal"}], "datos_para_biografia": [{"dato": "Se formó en 1983 con Trey Azagthoth (guitarra/compositor principal), Dallas Ward (voz y bajo) y Mike Browning (batería).", "url": "https://en.wikipedia.org/wiki/Morbid_Angel", "cita": "Morbid Angel is an American death metal band based in Tampa, Florida, formed in 1983 by guitarist, primary composer and sole remaining original member Trey Azagthoth, vocalist and bassist Dallas Ward, and drummer Mike Browning."}, {"dato": "Fue la primera banda de death metal en lograr éxito mainstream, tras firmar con Giant Records en 1992.", "url": "https://en.wikipedia.org/wiki/Morbid_Angel", "cita": "Morbid Angel was also the first death metal band to experience mainstream success in connection with being signed to Giant Records in 1992, heavy rotation of its music videos on MTV"}, {"dato": "Su álbum debut Altars of Madness (1989) fue clasificado primero por la revista Terrorizer en su lista \"Top 40 greatest death metal albums\".", "url": "https://en.wikipedia.org/wiki/Morbid_Angel", "cita": "British music magazine Terrorizer ranked Altars of Madness first in its list \"Top 40 greatest death metal albums\"."}]}
