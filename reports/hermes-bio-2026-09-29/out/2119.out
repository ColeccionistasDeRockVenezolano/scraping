{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock.html", "cita": "16. Sotter - Inmortal"}, {"url": "https://matracametal.blogspot.com/2008/08/bnda-zulia.html", "cita": "Luego vino \"Sotter\" banda de brutal Death, tocando temas tales como \"Obsesión asesina\" o \"Faithul Word”, esta banda dejo al público con muchas ganadas de seguir escuchado buen metal."}], "pais": {"valor": "Venezuela", "url": "https://www.facebook.com/MetalLethal/photos/bateristas-venezolanosgustavo-suarez-divuskirius-vzla-sotter-vzla-deseret-ecua-e/1419576019465958/", "cita": "BATERISTAS VENEZOLANOS Gustavo Suarez {Divuskirius (Vzla), Sotter (Vzla), Deseret (Ecua.)"}, "ciudad": null, "año_formacion": {"valor": 2002, "url": "https://www.facebook.com/sotterband/", "cita": "Sotter nació en el año 2002 con mucha ilusión y esfuerzo, y desde entonces hicimos la música que amábamos tocar"}, "generos": [{"genero": "Death Metal", "url": "https://matracametal.blogspot.com/2008/08/bnda-zulia.html", "cita": "SOTTER / Death Metal / Grindcore (Zulia)"}, {"genero": "Grindcore", "url": "https://matracametal.blogspot.com/2008/08/bnda-zulia.html", "cita": "SOTTER / Death Metal / Grindcore (Zulia)"}], "datos_para_biografia": [{"dato": "Conserva un ensayo de sus inicios (2002) grabado con una grabadora portátil, al que llaman reliquia", "url": "https://www.facebook.com/sotterband/", "cita": "Existe un ensayo de los inicios de SOTTER por allá en el 2002, se grabó con una grabadora portátil y si se logra entender sorprendentemente jajaja para nosotros es una reliquia"}, {"dato": "En 2008 tocó en el Vida Radical Fest (Zulia) con temas como 'Obsesión asesina' y 'Faithful Word'", "url": "https://matracametal.blogspot.com/2008/08/bnda-zulia.html", "cita": "Luego vino \"Sotter\" banda de brutal Death, tocando temas tales como \"Obsesión asesina\" o \"Faithul Word”"}, {"dato": "El baterista Gustavo Suarez (de Divuskirius) también integró Sotter", "url": "https://www.facebook.com/MetalLethal/photos/bateristas-venezolanosgustavo-suarez-divuskirius-vzla-sotter-vzla-deseret-ecua-e/1419576019465958/", "cita": "Gustavo Suarez {Divuskirius (Vzla), Sotter (Vzla), Deseret (Ecua.)"}]}
