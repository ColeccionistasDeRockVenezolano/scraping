{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/release/a75c20a6-93a3-449d-a2b8-7065d3d6263d", "cita": "Voice of the Soul (Zardonic remix) (2012 revamp) remixer: Zardonic recording of: Voice of the Soul (Death song) composer: Chuck Schuldiner publisher: Mutilation Music"}, {"url": "https://musicbrainz.org/artist/dbb3b771-ae77-4381-b61c-758b5b7898ec", "cita": "Death (US death metal band)"}, {"url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "The band's 1987 debut album, Scream Bloody Gore, is regarded as one of the first death metal records"}], "pais": {"valor": "Estados Unidos", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Origin Altamonte Springs, Florida, U.S."}, "ciudad": {"valor": "Altamonte Springs", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Death was an American death metal band formed in Altamonte Springs, Florida, in 1983"}, "año_formacion": {"valor": 1983, "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Death was an American death metal band formed in Altamonte Springs, Florida, in 1983 by guitarist Chuck Schuldiner"}, "generos": [{"genero": "Death metal", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Genres Death metal· progressive metal· technical death metal"}, {"genero": "Progressive metal", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Genres Death metal· progressive metal· technical death metal"}, {"genero": "Technical death metal", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Genres Death metal· progressive metal· technical death metal"}], "datos_para_biografia": [{"dato": "Comenzó como Mantas en 1983 y cambió su nombre a Death un año después", "url": "https://musicbrainz.org/artist/dbb3b771-ae77-4381-b61c-758b5b7898ec", "cita": "The band was originally started as Mantas in 1983 and changed its name to Death a year later."}, {"dato": "Chuck Schuldiner fue su único miembro constante y la banda se disolvió tras su muerte en diciembre de 2001", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Death had a fluctuating lineup, with Schuldiner, aside from a European tour, the sole consistent member. The band disbanded after Schuldiner died of glioma and pneumonia in December 2001"}, {"dato": "Pionera del death metal, formada en la escena de Florida", "url": "https://en.wikipedia.org/wiki/Death_(metal_band)", "cita": "Formed out of what would become the Florida death metal scene, Death is considered a pioneering death metal band."}]}
