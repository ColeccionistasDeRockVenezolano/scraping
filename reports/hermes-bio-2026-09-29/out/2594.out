{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=bJPm3LIvoFE", "cita": "Jason - Rostros Ocultos (cover KRAKEN) Album: Tributo Internacional A Kraken Año: 2008 Integrantes : Indio Alexis Bajo Diego Michel Batéria Majo Di Pasquo Teclados Ariel Ranieri Guitarra Tano Maiorell Voz"}, {"url": "https://www.youtube.com/watch?v=f9lopqj6blI", "cita": "-9 \"Rostros Ocultos\" on Tributo Internacional a Kraken CD 1 (Etnia Records, 2xCD, 2008)"}, {"url": "https://rock.com.ar/artistas/jason", "cita": "Ariel Ranieri: guitarra y voces / Tano Maiorell: voz / Martín De Pas: batería / Pulpiyo Velizan: bajo / Ex Integrantes / Alexis Indio Jacobchuc: bajo / Majo Di Pasquo: teclados"}], "pais": {"valor": "Argentina", "url": "https://www.youtube.com/watch?v=f9lopqj6blI", "cita": "BANDA: JASON \nCountry: Argentina\nGenero: Heavy Metal / Power Metal"}, "ciudad": {"valor": "Gral. San Martín (Provincia de Buenos Aires)", "url": "https://rock.com.ar/artistas/jason", "cita": "Jason nace en 1991 en el partido de Gral. San Martín (Provincia de Buenos Aires)"}, "año_formacion": {"valor": 1991, "url": "https://rock.com.ar/artistas/jason", "cita": "Jason nace en 1991 en el partido de Gral. San Martín (Provincia de Buenos Aires)"}, "generos": [{"genero": "Heavy Metal / Power Metal", "url": "https://www.youtube.com/watch?v=f9lopqj6blI", "cita": "Genero: Heavy Metal / Power Metal"}, {"genero": "Hard rock progresivo y heavy clásico", "url": "https://rock.com.ar/artistas/jason", "cita": "con un estilo muy definido, siguiendo como influencias a los máximos exponentes del hard rock progresivo y heavy clásico, como Deep Purple, Queen, Ozzy, o Black Sabbath."}], "datos_para_biografia": [{"dato": "Primera producción independiente «Jason 1995», cassette con ocho temas propios y dos covers de Black Sabbath; en diciembre de 1996 fueron considerados Banda Revelación del Sí de Clarín.", "url": "https://rock.com.ar/artistas/jason", "cita": "«Jason 1995», la primera producción independiente, es un cassette editado en el año ’95, que contiene ocho temas de la banda y 2 covers de Black Sabbath. Este material los catapultó a ser considerados Banda Revelación del Sí de Clarín, en diciembre del ’96."}, {"dato": "En 1997 publicaron su primer CD, «Justiciero arcaico», también producido de forma independiente.", "url": "https://rock.com.ar/artistas/jason", "cita": "En 1997 llega su primera producción en CD, «Justiciero arcaico» también producido independientemente."}, {"dato": "Fueron teloneros recurrentes de artistas extranjeros como Angra, Stratovarius o Yngwie Malmsteen.", "url": "https://rock.com.ar/artistas/jason", "cita": "A lo largo de su carrera fueron invitados reiteradamente para presentarse como grupos soporte de artistas extranjeros, como Angra, Stratovarius o Yngwie Malmsteen."}]}
