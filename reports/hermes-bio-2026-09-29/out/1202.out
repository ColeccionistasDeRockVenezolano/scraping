{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musitecadiscos.com/product/circuito-nb1/", "cita": "4. Páymaco– Pubertad"}, {"url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Albums: Pubertad"}, {"url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "More artists in Pop & Rock More artists from Venezuela"}, {"url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Description: Bájenla que queda pocos días!!!, porque en noviembre vamos a subir nustro tema nuevo:Pubertad."}], "pais": {"valor": "Venezuela", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Location: Caracas, D.F. Venezuela"}, "ciudad": {"valor": "Caracas", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Location: Caracas, D.F. Venezuela"}, "año_formacion": {"valor": 1996, "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Páymaco nació en 1996 con la idea de dos amigos en hacer lo mismo que sus heroes, pero dandole un nuevo camino a los oidos del mundo..............y eso ha sido su objetivo!!."}, "generos": [{"genero": "Pop-ruido", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Music style: Pop-ruido"}, {"genero": "Rock pop-ruido", "url": "https://www.oocities.org/sunsetstrip/lounge/8119/geobook.html", "cita": "una nueva banda de rock pop-ruido de Venezuela, el nombre del grupo es Páymaco"}], "datos_para_biografia": [{"dato": "Integrantes: Carlos Luis (bajo, canto y coros), Jaime «SJ» (guitarra, canto y coros), José Gabriel (batería y coros) y Tornillo/Rafael (guitarra)", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Carlos Luis: Bajo, Canto y Coros. Jaime (SJ): Guitarra, Canto y Coros. José Gabriel: Bateria y Coros. Tornillo (Rafael): Guitarra y lo que pueda hacer ¿?."}, {"dato": "Influencias musicales: The Who, Ramones, Blur, Weezer, Rentals, Sentimiento Muerto y La Leche", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Musical influences: The Who, Ramones, Blur, Weezer, Rentals, Sentimiento Muerto y La Leche."}, {"dato": "Su tema/álbum «Pubertad» lo subieron a MP3.com en noviembre de 1999 y luego apareció en la compilación venezolana Circuito NB1 (2000), editada por Fundación Nuevas Bandas", "url": "https://web.archive.org/web/19991128112729/http://artists.mp3s.com/artists/52/pymaco.html", "cita": "Bájenla que queda pocos días!!!, porque en noviembre vamos a subir nustro tema nuevo:Pubertad."}]}
