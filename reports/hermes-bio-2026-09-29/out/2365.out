{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "Die Jungs nennen ihre Musik \"Farmgrind\" und genau das bekommt man auch, \"Zombie Cows From Outer Space\" ist feinster Bauern-Goregrind, gewürzt mit einer Menge Humor!"}, {"url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "10. Zombie Cows from Outer Space 01:58"}, {"url": "https://www.youtube.com/watch?v=_cNsBEBsNIU", "cita": "Farmgrind (as they call their music) band from Tyrol, Austria since 2016. This is their first full length album."}], "pais": {"valor": "Austria", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "BITCHFORK aus Österreich liefern hier ein ganz feines Debütalbum ab welches in keiner Goregrind-Sammlung fehlen darf!"}, "ciudad": {"valor": "Vils", "url": "https://www.facebook.com/p/Bitchfork-20-61561264534973/", "cita": "Bitchfork 2.0 | Vils | Facebook"}, "año_formacion": {"valor": 2016, "url": "https://www.youtube.com/watch?v=_cNsBEBsNIU", "cita": "Farmgrind (as they call their music) band from Tyrol, Austria since 2016. This is their first full length album."}, "generos": [{"genero": "Farmgrind", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "Die Jungs nennen ihre Musik \"Farmgrind\" und genau das bekommt man auch"}, {"genero": "Goregrind", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "\"Zombie Cows From Outer Space\" ist feinster Bauern-Goregrind, gewürzt mit einer Menge Humor!"}, {"genero": "Grindcore", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "grindcore"}, {"genero": "Death Metal", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "death metal"}], "datos_para_biografia": [{"dato": "El álbum 'Zombie Cows from Outer Space' es su primer larga duración, editado en diciembre de 2018 en CD por Splatter Zombie Records", "url": "https://www.youtube.com/watch?v=_cNsBEBsNIU", "cita": "This is their first full length album.Released on December 2018 (CD format) by Splatter Zombie Records."}, {"dato": "Trío con el lema 'Von Bauern für Bauern' (de granjeros para granjeros)", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "Von Bauern für Bauern, das ist das Motto dieser dreiköpfigen Band, die euch feinsten \"Farm Grind\" in die Ohren blasen."}, {"dato": "El disco debut se publicó el 7 de diciembre de 2018", "url": "https://bitchforkaustria.bandcamp.com/album/zombie-cows-from-outer-space", "cita": "se lanzó el 7dediciembrede2018"}]}
