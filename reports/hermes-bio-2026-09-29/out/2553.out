{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Meshuggah () is a Swedish extreme metal band formed in Umeå in 1987."}, {"url": "https://musicbrainz.org/search?query=Future+Breed+Machine&type=recording&method=indexed", "cita": "Future Breed Machine | 5:49 | Meshuggah | Destroy Erase Improve (\"Found 263,685 results for \\\"Future Breed Machine\\\"\")"}], "pais": {"valor": "Sweden", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Founded in: Umeå, Västerbotten (Västerbotten county), Sweden — Area: Sweden"}, "ciudad": {"valor": "Umeå", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Swedish extreme metal band formed in Umeå in 1987"}, "año_formacion": {"valor": 1987, "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Founded: 1987 (39 years ago)"}, "generos": [{"genero": "progressive metal", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "progressive metal"}, {"genero": "death metal", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "death metal"}, {"genero": "djent", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "djent"}], "datos_para_biografia": [{"dato": "Formación estable desde 2004: Jens Kidman (voz), Fredrik Thordendal (guitarra), Mårten Hagström, Tomas Haake y Dick Lövgren", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Since 2004, the band's lineup consists of founding members Jens Kidman (lead vocals) and Fredrik Thordendal (lead guitar), alongside rhythm guitarist Mårten Hagström, drummer Tomas Haake and bassist Dick Lövgren."}, {"dato": "Nueve álbumes de estudio, seis EPs y ocho videos musicales; último álbum Immutable (abril 2022, Atomic Fire Records)", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "Since its formation, the band has released nine studio albums, six EPs and eight music videos. Their latest studio album, Immutable, was released in April 2022 via Atomic Fire Records."}, {"dato": "Inspiró el subgénero djent a finales de los 2000", "url": "https://musicbrainz.org/artist/cf8b3b8c-118e-4136-8d1d-c37091173413", "cita": "In the late 2000s, the band inspired the djent subgenre."}]}
