{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Subliminal Sense es un banda de Death metal melódico de Porlamar – Margarita, fue fundada en el 2009 por Victor Moreno, Giuseppe Santangelo y Mario Moreno."}, {"url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Actualmente Subliminal Sense está en producción de su primer EP “A Perception Of The Human Lost” que constara, 5 temas; Con el lanzamiento de su primer sencillo “Deepest Void”, y ya en estudio grabando su 2 tema (awakening) este y muchos proyectos más tiene entre manos Subliminal para este año y los que vienen"}, {"url": "https://soundcloud.com/subliminal-sense", "cita": "Nueva Esparta, Bolivarian Republic of Venezuela"}, {"url": "https://rockhechovzla.blogspot.com/2020/02/metalkinesia-capitulo-nueva-esparta.html", "cita": "KINETIC llegó con sed, pero sed de metal y de la mano de JUAN NIEVES, ARTURO RUMBOS y AMÍLCAR NAVARRO encontró 25 bandas que cultivan las diferentes tendencias del metal y con ellos se logró armar el \"CAPÍTULO NUEVA ESPARTA\" ... y otras corrientes de música extrema (SUBLIMINAL SENSE, SOUTHERN TEMPEST, SULLEN, ASTRARIA, CHAOS DESCENDS, REMEMBRANCE, 2HD)"}], "pais": {"valor": "Venezuela", "url": "https://soundcloud.com/subliminal-sense", "cita": "Nueva Esparta, Bolivarian Republic of Venezuela"}, "ciudad": {"valor": "Porlamar", "url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Subliminal Sense es un banda de Death metal melódico de Porlamar – Margarita, fue fundada en el 2009 por Victor Moreno, Giuseppe Santangelo y Mario Moreno."}, "año_formacion": {"valor": 2009, "url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "fue fundada en el 2009 por Victor Moreno, Giuseppe Santangelo y Mario Moreno"}, "generos": [{"genero": "Death metal melódico", "url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Subliminal Sense es un banda de Death metal melódico de Porlamar – Margarita"}], "datos_para_biografia": [{"dato": "Fundada en 2009 por Victor Moreno, Giuseppe Santangelo y Mario Moreno en Porlamar, Margarita", "url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Subliminal Sense es un banda de Death metal melódico de Porlamar – Margarita, fue fundada en el 2009 por Victor Moreno, Giuseppe Santangelo y Mario Moreno."}, {"dato": "Primer EP «A Perception Of The Human Lost», con primer sencillo «Deepest Void» y tema «awakening»", "url": "https://paltoque.com/biografia-subliminal-sense/", "cita": "Actualmente Subliminal Sense está en producción de su primer EP “A Perception Of The Human Lost” que constara, 5 temas; Con el lanzamiento de su primer sencillo “Deepest Void”, y ya en estudio grabando su 2 tema (awakening)"}, {"dato": "Incluida en el 13.º compilatorio «Capítulo Nueva Esparta» (2020) de la «Enciclopedia Sonora del Metal Venezolano»", "url": "https://rockhechovzla.blogspot.com/2020/02/metalkinesia-capitulo-nueva-esparta.html", "cita": "encontró 25 bandas que cultivan las diferentes tendencias del metal y con ellos se logró armar el \"CAPÍTULO NUEVA ESPARTA\" para dar continuidad a la “Enciclopedia Sonora del Metal Venezolano”. ... y otras corrientes de música extrema (SUBLIMINAL SENSE, SOUTHERN TEMPEST, SULLEN, ASTRARIA, CHAOS DESCENDS, REMEMBRANCE, 2HD)"}]}
