{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=Pyk6ycOptO0", "cita": "LOS NAVAJO - Ted Bundy (Video Oficial)"}, {"url": "https://descargasmetalvenezolano.blogspot.com/search?q=delicado+sonido+del+rock", "cita": "Maracaibo - El Delicado Sonido del Rock - Volumen IV (2020) ... 09. Los Navajo - Ted Bundy"}, {"url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "quienes debutaron en el mercado musical el pasado 17 de Junio de 2013 con su primer sencillo llamado “Ted Bundy”"}], "pais": null, "ciudad": {"valor": "Cabimas", "url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "Desde la Costa Oriental Del Lago (Cabimas, edo. Zulia) nacen “Los Navajo”, una nueva banda cargada de estilo y energía"}, "año_formacion": {"valor": 2009, "url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "El concepto de la banda “los Navajo” nace a finales del 2009, cuando Roxette Barrios, (vocalista) conoce a Nelson Pineda (guitarrista líder)."}, "generos": [{"genero": "Rock and Roll / rock n' roll", "url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "Crecen los talentos en conjunto con las nuevas propuestas del \"rock n' roll\" nacional de calidad."}, {"genero": "Rock zuliano", "url": "https://www.youtube.com/@losnavajorock/about", "cita": "Canal Official de la banda de Rock Zuliana,Los Navajo."}], "datos_para_biografia": [{"dato": "El sencillo debut de la banda fue \"Ted Bundy\", estrenado el 17 de junio de 2013 y descargado 1200 veces en un día.", "url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "El sencillo debut de la banda (Ted Bundy) fue estrenado el pasado 17 de Junio y a tan solo un dìadepublicado en descarga gratuita a través de nuestras redes sociales logró alcanzar las 1200 descargas"}, {"dato": "Origen del proyecto: la vocalista Roxette Barrios conoció al guitarrista Nelson Pineda y juntos concretaron la agrupación.", "url": "https://la-cartelera-web.webnode.com.ve/news/los-navajo-llegaron-para-quedarse-/", "cita": "Roxette Barrios, (vocalista) conoce a Nelson Pineda (guitarrista líder). Luego de compartir varias charlas referentes a la música y/o estilos musicales se decide finalmente reunirse a concretar ideas y a compartir composiciones propias"}, {"dato": "Integrantes de la banda: Roxette Barrios, Marcial Pino, Nelson Pineda, Yimmy Martínez y Jorge Guerra.", "url": "https://www.youtube.com/watch?v=Pyk6ycOptO0", "cita": "LOS NAVAJO: Roxette Barrios, Marcial Pino, Nelson Pineda, Yimmy Martínez y Jorge Guerra."}]}
