{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_5.html", "cita": "17. Violetas Negras - Quiero dejar de Beber"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_5.html", "cita": "Banda: Maracaibo Álbum: El Delicado Sonido del Rock - Volumen II Lanzamiento: 2020 Género: Hard/Heavy/Thrash/Death/Black/Hardcore... Lugar: Maracaibo - Venezuela"}, {"url": "https://acanohaynadarockum.wixsite.com/acaescribimos/post/violetas-negras-no-te-puedo-olvidar", "cita": "Manuel le inyectó a Violetas Negras más rock and Roll, más malandrismo. Compuso gran parte de los temas propios de la banda, temas como Quiero Dejar de Beber y la poisonesca No Te Puedo Olvidar."}, {"url": "https://www.reverbnation.com/violetasnegras", "cita": "Alternative / Indie Rock / Spanish Rock • Maracaibo, VE"}, {"url": "https://www.reverbnation.com/violetasnegras", "cita": "No Te Puedo Olvidar ... Dejar de Beber"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=KRbCWeMw6rk", "cita": "violetas negras 4th gig Mcbo, zulia,Venezuela. 1991 November Pub."}, "ciudad": {"valor": "Maracaibo", "url": "https://www.reverbnation.com/violetasnegras", "cita": "Alternative / Indie Rock / Spanish Rock • Maracaibo, VE"}, "año_formacion": {"valor": 1990, "url": "https://acanohaynadarockum.wixsite.com/acaescribimos/post/violetas-negras-no-te-puedo-olvidar", "cita": "Si la memoria no me falla, fue en diciembre de 1990 cuando los vi por primera vez, tocando en un Parrandón Navideño del Liceo Los Robles. Creo, ese fue el debut de los Violetas Negras."}, "generos": [{"genero": "Rock Latino", "url": "https://www.reverbnation.com/violetasnegras", "cita": "Violetas Negras fue la banda de Rock Latino mas famosa que nunca obtuvo la fama."}, {"genero": "Alternative / Indie Rock / Spanish Rock", "url": "https://www.reverbnation.com/violetasnegras", "cita": "Alternative / Indie Rock / Spanish Rock • Maracaibo, VE"}], "datos_para_biografia": [{"dato": "Banda de rock latino de Maracaibo activa entre 1990 y 1998, convertida en leyenda del rock marabino.", "url": "https://www.reverbnation.com/violetasnegras", "cita": "Violetas Negras fue la banda de Rock Latino mas famosa que nunca obtuvo la fama. Tocando en Maracaibo entre 1990 y 1998, Violetas Negras revoluciono el rock Marabino y se convirtio en un estandarte musical, una leyenda ro..."}, {"dato": "Su vocalista y frontman, Manuel Armas, compuso la mayor parte de los temas propios, entre ellos «Quiero Dejar de Beber» y «No Te Puedo Olvidar».", "url": "https://acanohaynadarockum.wixsite.com/acaescribimos/post/violetas-negras-no-te-puedo-olvidar", "cita": "Manuel le inyectó a Violetas Negras más rock and Roll, más malandrismo. Compuso gran parte de los temas propios de la banda, temas como Quiero Dejar de Beber y la poisonesca No Te Puedo Olvidar."}, {"dato": "En Maracaibo abrieron conciertos a bandas como Sentimiento Muerto, Caramelos de Cianuro y Zapato 3.", "url": "https://acanohaynadarockum.wixsite.com/acaescribimos/post/violetas-negras-no-te-puedo-olvidar", "cita": "Yo recuerdo haberlos visto abriéndole a Sentimiento Muerto en su gira Sin Sombra No Hay Luz, y a Caramelos de Cianuro en su debut en Maracaibo, ambos shows con uno o dos años de diferencia en el legendario Club Alianza."}]}
