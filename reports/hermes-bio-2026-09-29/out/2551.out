{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://soundcloud.com/zardonic/bathory-equimanthorn-zardonic-remix-2007", "cita": "Bathory - Equimanthorn (Zardonic Remix) [2007] ... Originally released as part of the \"Metal Up Your Bass\" 2007 LP (not the 2012 reVAMPED Edition)"}, {"url": "https://en.wikipedia.org/wiki/Under_the_Sign_of_the_Black_Mark", "cita": "\"Under the Sign of the Black Mark\" is the third studio album by Swedish extreme metal band Bathory. ... The song \"Equimanthorn\" makes references to Hell as well as to Norse mythology, including Odin's \"eight-legged black stallion\" Sleipnir."}, {"url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory was a Swedish extreme metal band formed in Vällingby in March 1983. Frontman and songwriter Thomas \"Quorthon\" Forsberg was the sole constant member, and at times responsible for all instruments."}], "pais": {"valor": "Sweden", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory was a Swedish extreme metal band formed in Vällingby in March 1983."}, "ciudad": {"valor": "Vällingby", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory was a Swedish extreme metal band formed in Vällingby in March 1983."}, "año_formacion": {"valor": 1983, "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory was a Swedish extreme metal band formed in Vällingby in March 1983."}, "generos": [{"genero": "Black metal", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Black metal· Viking metal· thrash metal"}, {"genero": "Viking metal", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Black metal· Viking metal· thrash metal"}, {"genero": "Thrash metal", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Black metal· Viking metal· thrash metal"}], "datos_para_biografia": [{"dato": "Fundada en marzo de 1983 en Vällingby; su único miembro constante fue el frontman y compositor Thomas \"Quorthon\" Forsberg.", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory was a Swedish extreme metal band formed in Vällingby in March 1983. Frontman and songwriter Thomas \"Quorthon\" Forsberg was the sole constant member, and at times responsible for all instruments."}, {"dato": "Considerada pionera del black metal y del viking metal, con los primeros cuatro discos descritos como el modelo del black metal escandinavo.", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "Bathory is considered a pioneer of black metal ... and Viking metal. The book Lords of Chaos described Bathory's first four albums as \"the blueprint for Scandinavian black metal.\""}, {"dato": "La banda dejó de tocar en directo pronto y nunca hizo giras; se disolvió tras la muerte de Quorthon por un fallo cardíaco en junio de 2004.", "url": "https://en.wikipedia.org/wiki/Bathory_(band)", "cita": "The band stopped performing live early on and never toured. Bathory dissolved when Quorthon died from heart failure at age 38 in June 2004."}]}
