{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=dC0sgXxxEKA", "cita": "05. DJ Luigi Daniel & Alfredo Mena - Margarita 18:35"}, {"url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "Al igual con las ediciones de “VENEZUELA ELECTRONICA” con Hits como, MARGARITA tema que estuvo en el record report radial en Venezuela, y el tema IN THE MIX"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "fue uno de los primeros DJS Free lance en Venezuela que comenzó a recorrer el país de punta a punta en los diferentes clubs y eventos de música electrónica en Venezuela"}, "ciudad": {"valor": "Caracas", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "Alfredo Mena nació en caracas"}, "año_formacion": null, "generos": [{"genero": "música electrónica", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "eventos de música electrónica en Venezuela"}, {"genero": "Tech House", "url": "https://soundcloud.com/search?q=Alfredo%20Mena%20Margarita", "cita": "Alfredo Mena - Do You Remember (Bonzai Basiks) ... # Tech House"}], "datos_para_biografia": [{"dato": "Fue uno de los primeros DJs freelance de Venezuela; inició su carrera en el mundo de las minitecas.", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "Alfredo Mena nació en caracas comenzó su carrera profesional en el mundo de las minitecas, fue uno de los primeros DJS Free lance en Venezuela"}, {"dato": "Produjo junto a Luigi Daniell los temas \"Bailando desnudo\" y \"Avila drums\" para el sello Black Sun Records, de Barcelona (España).", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "Entre sus producciones discográficas solo por nombrar algunas se encuentran “Bailando desnudo” y “Avila drums” Del Sello black Sun records de Barcelona España Producido junto a LUIGIDANIELL en modo VINYL"}, {"dato": "Tocó en clubes de Miami (Nikki Beach, Club Space) durante la Winter Music Conference y figuró en el compilado \"Lights Out Decade\" de Steve Lawler (VIVA Music).", "url": "https://www.youtube.com/watch?v=5SPSuAsE-2w", "cita": "durante 3 años consecutivos en los Closing parties del afamado CLUB SPACE en pleno Winter Music conference"}]}
