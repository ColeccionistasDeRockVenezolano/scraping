{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/cabimas-la-cuna-del-rock-compilado.html", "cita": "19.Sepulcro - No Puedes Escapar"}, {"url": "https://descargasmetalvenezolano.blogspot.com/search?q=Sepulcro", "cita": "11. Sepulcro - Venezuela (Pedro Herrero/Armenteros)"}, {"url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "obteniendo su paso inmediato, para participar en el “Festival 100% Venezolano”, en la Plaza Montes de Oca, en esa misma ciudad."}, {"url": "https://www.youtube.com/watch?v=fGHEBNhBO6o", "cita": "Sepulcro - Banda de Heavy Metal Venezolana Nelson Ramirez (Kiro) - Voz Argenis Diaz - Bateria Tomly Coronel - Guitarra 1 Renny Rivero - Bajo"}], "pais": {"valor": "Venezuela", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "Esta banda de Heavy Metal tradicional, se formó en el año 1994, en Valencia, Edo. Carabobo-Venezuela"}, "ciudad": {"valor": "Valencia", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "Esta banda de Heavy Metal tradicional, se formó en el año 1994, en Valencia, Edo. Carabobo-Venezuela"}, "año_formacion": {"valor": 1994, "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "Esta banda de Heavy Metal tradicional, se formó en el año 1994, en Valencia, Edo. Carabobo-Venezuela"}, "generos": [{"genero": "Heavy Metal", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "Esta banda de Heavy Metal tradicional, se formó en el año 1994, en Valencia, Edo. Carabobo-Venezuela"}, {"genero": "Heavy Metal", "url": "https://www.youtube.com/watch?v=fGHEBNhBO6o", "cita": "Sepulcro - Banda de Heavy Metal Venezolana"}], "datos_para_biografia": [{"dato": "El grupo nació con el nombre SNUCO y adoptó el nombre SEPULCRO alrededor de 1998", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "alrededor del año 1998 comenzaron a discutir, ente ellas el nombre del grupo, luego de tanta discusión Argénis dio en el clavo, se llamarían SEPULCRO"}, {"dato": "Su primera presentación en vivo fue el 14 de diciembre de 2001, versionando temas de Iron Maiden", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "El primer contacto con el público, fue en una fiesta, un 14 de Diciembre de 2001, versionando solo temas de Iron Maiden, junto a otra agrupación llamada “Tomaco”."}, {"dato": "Grabaron una maqueta con 5 canciones originales titulada «Sepulcro»", "url": "https://laencrucijadaradio.blogspot.com/2019_08_01_archive.html", "cita": "Hoy poseen 5 canciones originales, las cuales fueron grabadas para una maqueta, que salió bajo el nombre de “Sepulcro”."}]}
