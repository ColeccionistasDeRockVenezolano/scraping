{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://kingbeast.bandcamp.com/album/straps-of-wrath", "cita": "4. Fix The Problem 05:04"}, {"url": "https://kingbeast.bandcamp.com/album/straps-of-wrath", "cita": "Straps Of Wrath by KINGBÉAST, released 10 May 2019 ... 4. Fix The Problem ... All music and lyrics written by Heiko Jesenek."}, {"url": "https://www.kingbeast.de/home.html", "cita": "KINGBÉAST is a metal band from Nuremberg (Germany) and was founded in 2012 by Heiko Jesenek (g) and Tobias Bezold (dr)."}, {"url": "https://musicbrainz.org/artist/23fbfc63-c5cf-4521-a046-3305e552a969", "cita": "Kingbéast ~Group ... 2019 Straps of Wrath ... Founded: 2012 (14 years ago) Founded in: Nürnberg (Nuremberg), Bayern (Bavaria), Germany"}], "pais": {"valor": "Germany", "url": "https://www.kingbeast.de/home.html", "cita": "KINGBÉAST is a metal band from Nuremberg (Germany) and was founded in 2012 by Heiko Jesenek (g) and Tobias Bezold (dr)."}, "ciudad": {"valor": "Nuremberg", "url": "https://www.kingbeast.de/home.html", "cita": "KINGBÉAST is a metal band from Nuremberg (Germany) and was founded in 2012 by Heiko Jesenek (g) and Tobias Bezold (dr)."}, "año_formacion": {"valor": 2012, "url": "https://www.kingbeast.de/home.html", "cita": "KINGBÉAST is a metal band from Nuremberg (Germany) and was founded in 2012 by Heiko Jesenek (g) and Tobias Bezold (dr)."}, "generos": [{"genero": "Groove Metal", "url": "https://kingbeast.bandcamp.com/album/straps-of-wrath", "cita": "KINGBÉAST is a Groove Metal band from Nuremberg, Germany, founded in 2012."}, {"genero": "thrash metal", "url": "https://kingbeast.bandcamp.com/album/straps-of-wrath", "cita": "thrash metal"}, {"genero": "hardcore punk", "url": "https://kingbeast.bandcamp.com/album/straps-of-wrath", "cita": "hardcore punk"}], "datos_para_biografia": [{"dato": "Su segundo álbum «Straps Of Wrath» (que incluye «Fix The Problem») salió el 10.05.2019 por Black Sunset / MDD Records, ya como trío estable con Heiko Jesenek también a la voz.", "url": "https://www.kingbeast.de/home.html", "cita": "In this formation the band hit out their second album \"Straps Of Wrath\" on 10.05.2019 by Black Sunset / MDD Records."}, {"dato": "El bajista Daniel Sira se incorporó en diciembre de 2014.", "url": "https://www.kingbeast.de/home.html", "cita": "Since december 2014 Daniel Sira joined the band on bass guitar and provides plenty of power."}, {"dato": "Su primer álbum «Demonic Beast Arises» (2014) fue nombrado «Demo Of The Month» por la revista alemana ROCK HARD MAGAZINE en noviembre de 2014.", "url": "https://www.kingbeast.de/home.html", "cita": "\"Demonic Beast Arises\" was honoured as \"Demo Of The Month\" in the German ROCK HARD MAGAZINE in November 2014."}]}
