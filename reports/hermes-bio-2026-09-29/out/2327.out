{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://es.wikipedia.org/wiki/Tributo_a_Queen:_Los_grandes_del_rock_en_espa%C3%B1ol", "cita": "«Nosotros Te Conmoveremos» («We Will Rock You», interpretado por El General.)"}, {"url": "https://www.youtube.com/watch?v=GWkqVRLKT8A", "cita": "El General comenzó a cantar y componer canciones a la edad de 12 años en su país natal, Panama. ... El Poder del General, publicado en 1993, presentó un nuevo éxito de Edgardo Franco, un merengue llamado \"Caramelo\"."}, {"url": "https://es.wikipedia.org/wiki/El_General", "cita": "Edgardo Armando Franco (Ciudad de Panamá, 27 de septiembre de 1968), más conocido como El General, es un ex-rapero de reggae en español y dancehall panameño."}], "pais": {"valor": "Panamá", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Edgardo Armando Franco[1] (Ciudad de Panamá, 27 de septiembre de 1968), más conocido como El General, es un ex-rapero de reggae en español y dancehall panameño.[2]"}, "ciudad": {"valor": "Ciudad de Panamá", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Nacimiento 27 de septiembre de 1968 (58 años) Ciudad de Panamá, Panamá"}, "año_formacion": null, "generos": [{"genero": "Reggae en español", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Géneros Reggae en español, reguetón, dancehall, hip hop latino"}, {"genero": "Reguetón", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Géneros Reggae en español, reguetón, dancehall, hip hop latino"}, {"genero": "Dancehall", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Géneros Reggae en español, reguetón, dancehall, hip hop latino"}], "datos_para_biografia": [{"dato": "Grabó la versión «Nosotros Te Conmoveremos» de «We Will Rock You» para el álbum Tributo a Queen: Los Grandes del Rock en Español (1997)", "url": "https://es.wikipedia.org/wiki/Tributo_a_Queen:_Los_grandes_del_rock_en_espa%C3%B1ol", "cita": "«Nosotros Te Conmoveremos» («We Will Rock You», interpretado por El General.)"}, {"dato": "Es considerado uno de los pioneros del reggae en español y precursor del reggaetón", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Junto a otros artistas panameños de la década de 1990, como Nando Boom, Pocho Pan, El Maleante, el hondureño Shabakan, entre otros, se le considera como uno de los pioneros del Reggae en Español, que luego daría origen a la plena panameña y al género musical conocido como reggaetón."}, {"dato": "Se retiró de la industria musical en 2004", "url": "https://es.wikipedia.org/wiki/El_General", "cita": "Retirado de la industria musical en 2004"}]}
