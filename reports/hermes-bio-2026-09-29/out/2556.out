{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Primal Fear is a German power metal band formed in 1997 by Ralf Scheepers (vocals, ex-Gamma Ray) and Mat Sinner (bass and vocals, Sinner)."}, {"url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "the band toured through Europe, Japan, the US and South America including one of the band's biggest hits \"Metal Is Forever\""}, {"url": "https://www.youtube.com/watch?v=_DaKm2SqOSo", "cita": "Zardonic - Metal Up Your Bass | Primal Fear - Metal Is Forever (Zardonic Remix)"}, {"url": "https://www.youtube.com/watch?v=_DaKm2SqOSo", "cita": "track from Zardonic's metal up your bass from 2007, which weirdly enough it's harder to find the 2007 release than the 2012 revamp."}], "pais": {"valor": "Alemania", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Esslingen, Germany"}, "ciudad": {"valor": "Esslingen", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Esslingen, Germany"}, "año_formacion": {"valor": 1997, "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Primal Fear was founded in October 1997 by singer Ralf Scheepers and Mat Sinner."}, "generos": [{"genero": "Power metal", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Power metal· heavy metal"}, {"genero": "Heavy metal", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Power metal· heavy metal"}], "datos_para_biografia": [{"dato": "Formada por Ralf Scheepers (ex-Gamma Ray) y Mat Sinner tras no ser contratado Scheepers como sustituto de Rob Halford en Judas Priest.", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Sinner and Scheepers formed the band after Scheepers was not hired as Rob Halford's replacement in Judas Priest."}, {"dato": "Su álbum debut, publicado en febrero de 1998, entró en las listas alemanas en el puesto 48.", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "Their debut album Primal Fear was released in February 1998 and entered the German LP charts at place 48"}, {"dato": "«Metal Is Forever» figura entre sus mayores éxitos.", "url": "https://en.wikipedia.org/wiki/Primal_Fear_(band)", "cita": "including one of the band's biggest hits \"Metal Is Forever\""}]}
