{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_29.html", "cita": "30. Proyecto Boogie Boogie - Mixed"}, {"url": "https://www.youtube.com/@ProyectoBoogieBoogie/about", "cita": "Los BoogieBoogie @ProyectoBoogieBoogie • 20 suscriptores • 10 vídeos"}, {"url": "https://www.facebook.com/LosBoogieBoogie/", "cita": "Los Boogieboogie VZLA ... Página · Músico/grupo de música ... ProyectoBoogieBoogie.com"}, {"url": "https://laverdad.com/jose-roberto-estrena-video-de-a-donde-van/", "cita": "Pertenece a las bandas Sesiones en Acústico, Orquesta de Rock Sinfónico del Zulia y Funk y Rock y fue el creador del proyecto Boogie Boogie."}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/@ProyectoBoogieBoogie/about", "cita": "Rock and Roll & Pop .... Caracas --- Venezuela .... Para contrataciones: proyectoboogieboogie@gmail.com"}, "ciudad": {"valor": "Maracaibo", "url": "https://www.youtube.com/@ProyectoBoogieBoogie/about", "cita": "Proyecto BoogieBoogie (Maracaibo) Sesión en Vivo para Cita Musical (URBE TV)"}, "año_formacion": null, "generos": [{"genero": "Rock and Roll", "url": "https://www.youtube.com/@ProyectoBoogieBoogie/about", "cita": "Rock and Roll & Pop .... Caracas --- Venezuela ...."}, {"genero": "Pop", "url": "https://www.facebook.com/LosBoogieBoogie/", "cita": "Los temas más famosos de la historia del Pop y el Rock & Roll en Vivo para todos tus eventos | VENE"}], "datos_para_biografia": [{"dato": "Proyecto Boogie Boogie (Los BoogieBoogie / ProyectoBoogieBoogie) es un grupo venezolano que toca en vivo las canciones más famosas del Pop y del Rock and Roll, orientado a eventos y shows en vivo (covers).", "url": "https://www.facebook.com/LosBoogieBoogie/", "cita": "Los temas más famosos de la historia del Pop y el Rock & Roll en Vivo para todos tus eventos | VENE"}, {"dato": "Su canal de YouTube, abierto en diciembre de 2013, reúne presentaciones en Maracaibo (Club Náutico de Maracaibo) y una sesión en vivo para Cita Musical (URBE TV).", "url": "https://www.youtube.com/@ProyectoBoogieBoogie/about", "cita": "Proyecto BoogieBoogie En Vivo (Club Nautico de Maracaibo) #1"}, {"dato": "El músico marabino José Roberto es señalado por la prensa de Maracaibo como creador del proyecto Boogie Boogie.", "url": "https://laverdad.com/jose-roberto-estrena-video-de-a-donde-van/", "cita": "El cantautor marabino, José Roberto, estrenó el video musical de su primer sencillo promocional, A donde van [...] y fue el creador del proyecto Boogie Boogie."}]}
