{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "Esta banda se forma en Maracaibo, Edo. Zulia, Venezuela, a mediados del Septiembre 96' con un estilo muy diferente a otras, mezclando diferentes ritmos como el Powermetal, Hardcore, Punk y Thrash sobre todo con raíces extremas ... Sus temas son: María, Los Pelados, Explotado, Sentimientos, La Mancha, Policía Maldito, Quinceañera, Me quiero morir, Por Qué?, Odio."}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_29.html", "cita": "Banda: Maracaibo / Álbum: El Delicado Sonido del Rock - Volumen IV / Lanzamiento: 2020 / Género: Hard/Heavy/Thrash/Death/Black/Hardcore... / Lugar: Maracaibo - Venezuela ... 23. Skate Thrasher Punk - Quinceñera"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "Esta banda se forma en Maracaibo, Edo. Zulia, Venezuela, a mediados del Septiembre 96'"}, "ciudad": {"valor": "Maracaibo", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "Esta banda se forma en Maracaibo, Edo. Zulia, Venezuela, a mediados del Septiembre 96'"}, "año_formacion": {"valor": 1996, "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "Esta banda se forma en Maracaibo, Edo. Zulia, Venezuela, a mediados del Septiembre 96' con un estilo muy diferente a otras"}, "generos": [{"genero": "Punk", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "mezclando diferentes ritmos como el Powermetal, Hardcore, Punk y Thrash"}, {"genero": "Hardcore", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "mezclando diferentes ritmos como el Powermetal, Hardcore, Punk y Thrash"}, {"genero": "Thrash", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "mezclando diferentes ritmos como el Powermetal, Hardcore, Punk y Thrash"}, {"genero": "Powermetal", "url": "https://www.youtube.com/watch?v=yy6IBBt1atA", "cita": "mezclando d