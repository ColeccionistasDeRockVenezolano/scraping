{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "27. VodkApaticos - F2"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "Álbum: El Delicado Sonido del Rock - Volumen III"}, {"url": "https://soundcloud.com/vodkapaticos", "cita": "Vodk Apaticos es una banda de rock alternativo compuesta por 5 amigos de Maracaibo edo Zulia Venezuela."}, {"url": "https://soundcloud.com/vodkapaticos/f2-1", "cita": "# Rock"}], "pais": {"valor": "Venezuela", "url": "https://soundcloud.com/vodkapaticos", "cita": "maracaibo, Bolivarian Republic of Venezuela"}, "ciudad": {"valor": "Maracaibo", "url": "https://soundcloud.com/vodkapaticos", "cita": "maracaibo, Bolivarian Republic of Venezuela"}, "año_formacion": null, "generos": [{"genero": "Rock alternativo", "url": "https://soundcloud.com/vodkapaticos", "cita": "Vodk Apaticos es una banda de rock alternativo compuesta por 5 amigos de Maracaibo edo Zulia Venezuela."}, {"genero": "Rock", "url": "https://soundcloud.com/vodkapaticos/f2-1", "cita": "# Rock"}], "datos_para_biografia": [{"dato": "La banda la forman 5 amigos: Pit (vocalista), Cholo (bajista), Aden (guitarra principal), Venan (guitarra base) y Peter (batería).", "url": "https://soundcloud.com/vodkapaticos", "cita": "• Pit (Vocalista)"}, {"dato": "El proyecto nació cuando Pit dejó la banda de rock K2 y se unió a Cholo para empezar su propio proyecto.", "url": "https://soundcloud.com/vodkapaticos", "cita": "La idea de Vodk Apaticos surge hace un Año y medio luego de que Pit (Vocalista) deja la banda de rock valerana K2 y decide con Cholo (Bajista) empezar su propio proyecto musical influenciado por este mismo genero."}, {"dato": "Sus influencias incluyen bandas latinoamericanas como Zapato 3, Caramelos de Cianuro, Don Tetto y Soda Stereo.", "url": "https://soundcloud.com/vodkapaticos", "cita": "Las influencias de Vodk Apaticos varian entre los integrantes siendo, entre sus favoritas bandas como Gun’s n’ Roses, Black Tide, Incubus entre otras destacando claro bandas latinoamericanas como Zapato 3, Caramelos de Cianuro, Don Tetto, Soda Stereo, Mana etc."}]}
