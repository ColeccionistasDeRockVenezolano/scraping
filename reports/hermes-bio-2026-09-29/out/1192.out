{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_underground.htm", "cita": "02- Supositorio Social  (Francisco Mejía) 2:53 / Performed by Farándula Popular 03- El Sapo (José A. Pereira/Farándula Popular) 2:25 / by Farándula Popular"}, {"url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_underground.htm", "cita": "Farándula Popular (tracks 02, 03) Guitar & Backing Vocals: Roberto Castillo Bass & Vocals: Francisco Mejía Drums: José Miguel Nascimento"}, {"url": "https://redesayuda.org/2017/03/22/fran-mejia-de-todosantos-y-farandula-popular-podemos-actuar-de-otras-formas-ser-solidarios-con-las-ongs-crear-redes-y-puentes-con-activistas-en-otros-paises/", "cita": "Uno de esos venezolanos es Fran Mejía, músico de bandas como Farándula Popular y Todosantos"}], "pais": {"valor": "Venezuela", "url": "https://redesayuda.org/2017/03/22/fran-mejia-de-todosantos-y-farandula-popular-podemos-actuar-de-otras-formas-ser-solidarios-con-las-ongs-crear-redes-y-puentes-con-activistas-en-otros-paises/", "cita": "Uno de esos venezolanos es Fran Mejía, músico de bandas como Farándula Popular y Todosantos"}, "ciudad": {"valor": "Caracas", "url": "https://redesayuda.org/2017/03/22/fran-mejia-de-todosantos-y-farandula-popular-podemos-actuar-de-otras-formas-ser-solidarios-con-las-ongs-crear-redes-y-puentes-con-activistas-en-otros-paises/", "cita": "Toqué en Farándula Popular desde 1996 (Cuando tenía 14 años de edad) hasta 1999 (Cuanto tenía 17), de manera que casi nunca podía tocar por la noche en locales, más bien tocábamos mucho en matinées. Recuerdo que era una época interesante en Caracas"}, "año_formacion": null, "generos": [{"genero": "Independent Rock", "url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_underground.htm", "cita": "Various Artists Caracas Underground Independent Rock 1996 (CD)"}], "datos_para_biografia": [{"dato": "Su bajista y vocalista, Fran Mejía (Francisco Mejía), tocó en Farándula Popular desde 1996 (con 14 años) hasta 1999 (con 17), por lo que casi nunca podían tocar de noche y actuaban en matinées.", "url": "https://redesayuda.org/2017/03/22/fran-mejia-de-todosantos-y-farandula-popular-podemos-actuar-de-otras-formas-ser-solidarios-con-las-ongs-crear-redes-y-puentes-con-activistas-en-otros-paises/", "cita": "Toqué en Farándula Popular desde 1996 (Cuando tenía 14 años de edad) hasta 1999 (Cuanto tenía 17), de manera que casi nunca podía tocar por la noche en locales, más bien tocábamos mucho en matinées."}, {"dato": "Su formación en el compilado Caracas Underground era trío: Roberto Castillo (guitarra y coros), Francisco Mejía (bajo y voz) y José Miguel Nascimento (batería).", "url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_underground.htm", "cita": "Farándula Popular (tracks 02, 03) Guitar & Backing Vocals: Roberto Castillo Bass & Vocals: Francisco Mejía Drums: José Miguel Nascimento"}, {"dato": "En 1996 contribuyó con dos temas (Supositorio Social y El Sapo) al compilado Caracas Underground, producidos por la propia banda junto a Diego Márquez y Francisco Villanueva.", "url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_underground.htm", "cita": "All tracks Produced by the performers except tracks: 02-03 by Farándula Popular, Diego Márquez & Francisco Villanueva"}]}
