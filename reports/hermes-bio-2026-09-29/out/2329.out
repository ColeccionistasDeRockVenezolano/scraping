{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://es.wikipedia.org/wiki/Tributo_a_Queen:_Los_grandes_del_rock_en_espa%C3%B1ol", "cita": "«Algún Día» («Some Day One Day», interpretado por Soda Stereo.)"}, {"url": "https://es.wikipedia.org/wiki/Some_Day_One_Day", "cita": "En 1996, la banda argentina Soda Stereo grabó una versión en español de Some Day One Day llamada Algún Día, la cual fue incluida en el álbum Tributo a Queen: Los Grandes del Rock en Español, publicado en octubre de 1997."}], "pais": {"valor": "Argentina", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Origen: Buenos Aires, Argentina"}, "ciudad": {"valor": "Buenos Aires", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Origen: Buenos Aires, Argentina"}, "año_formacion": {"valor": 1982, "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Soda Stereo fue una banda de rock argentina formada en 1982 originalmente por el cantante y guitarrista Gustavo Cerati, el bajista Zeta Bosio y el baterista Charly Alberti."}, "generos": [{"genero": "Pop rock", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Género(s): Pop rock, new wave, rock alternativo, rock electrónico"}, {"genero": "New wave", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Género(s): Pop rock, new wave, rock alternativo, rock electrónico"}, {"genero": "Rock alternativo", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Género(s): Pop rock, new wave, rock alternativo, rock electrónico"}, {"genero": "Rock electrónico", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Género(s): Pop rock, new wave, rock alternativo, rock electrónico"}], "datos_para_biografia": [{"dato": "Es considerada por un sector de la crítica especializada como la banda más importante, popular e influyente del rock en español de todos los tiempos y una leyenda de la música latinoamericana.", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Es considerada por un sector de la crítica especializada como la banda más importante, popular e influyente del rock en español de todos los tiempos y una leyenda de la música latinoamericana."}, {"dato": "Fue el primer grupo de habla hispana en conseguir un éxito masivo en Latinoamérica.", "url": "https://es.wikipedia.org/wiki/Soda_Stereo", "cita": "Fueron el primer grupo de habla hispana en conseguir un éxito masivo en Latinoamérica y tuvieron un papel muy importante en el desarrollo y la difusión del rock latinoamericano y el rock en español durante los años 80 y los 90."}, {"dato": "Su versión «Algún Día» fue la última canción grabada en estudio por la banda antes de separarse en 1997.", "url": "https://es.wikipedia.org/wiki/Tributo_a_Queen:_Los_grandes_del_rock_en_espa%C3%B1ol", "cita": "La banda argentina Soda Stereo grabó «Algún Día» antes de separarse en 1997, siendo esta la última canción grabada en estudio por la banda."}]}
