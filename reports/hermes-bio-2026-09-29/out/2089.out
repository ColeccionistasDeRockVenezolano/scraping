{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://soundcloud.com/mantaoficial/manta-al-final", "cita": "Manta - Al Final"}, {"url": "https://soundcloud.com/mantaoficial", "cita": "Manta Oficial"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "23. Manta - Al Final"}], "pais": {"valor": "Venezuela", "url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "Lugar: Maracaibo - Venezuela"}, "ciudad": {"valor": "Maracaibo", "url": "https://soundcloud.com/mantaoficial", "cita": "Maracaibo, Bolivarian Republic of Venezuela"}, "año_formacion": {"valor": 2001, "url": "https://soundcloud.com/mantaoficial", "cita": "Formados en 2001, nacimos tras la búsqueda de sonidos nuevos influenciados directamente por ritmos de guitarras cargadas de vida"}, "generos": [{"genero": "Rock", "url": "https://soundcloud.com/mantaoficial/manta-al-final", "cita": "# rock"}, {"genero": "Hard/Heavy/Thrash/Death/Black/Hardcore", "url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "Género: Hard/Heavy/Thrash/Death/Black/Hardcore..."}], "datos_para_biografia": [{"dato": "Integrantes: Nerio Romero (Batería), César Balbás (Guitarra), Freddy Parra (Guitarra), Carlos Bernardoni (Bajo) y Gianluigi Borrelli (Voz)", "url": "https://soundcloud.com/mantaoficial", "cita": "Nerio Romero (Batería), César Balbás (Guitarra), Freddy Parra (Guitarra), Carlos Bernardoni (Bajo) y Gianluigi Borrelli (Voz) son los inigualables que le dan vida a este proyecto que sembró un legado musical en la región durante sus inicios."}, {"dato": "Proyecto de rock formado en 2001, con guitarras, beats y ambiente electrónico", "url": "https://soundcloud.com/mantaoficial", "cita": "Formados en 2001, nacimos tras la búsqueda de sonidos nuevos influenciados directamente por ritmos de guitarras cargadas de vida, beats inigualables que crean una sensación intensa de fervor mezclado de un ambiente electrónico y perfeccionado con voces que colmarán tu cabeza de buena música."}, {"dato": "Su sencillo «Al Final» figura como pista 23 del compilado El Delicado Sonido del Rock - Volumen III (2020)", "url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "23. Manta - Al Final"}]}
