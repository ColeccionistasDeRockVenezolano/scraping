{"identidad_confirmada": true, "pruebas_identidad": [{"url":"https://soundcloud.com/corriente-alterna-1","cita":"CORRIENTE ALTERNA \nMARACAIBO, Bolivarian Republic of Venezuela ... CORRIENTE ALTERNA\nViaje\nPosted 15 years ago\n15 years ago\npsychodelic rock"}, {"url":"https://soundcloud.com/corriente-alterna-1/sets/corriente-alterna","cita":"producto final resultante de la mala junta / good fellas haciendo rock and roll ... # maracaibo # rock # corriente # alterna ... # venezuela # zulia ... Avion ... Viaje"}, {"url":"https://www.youtube.com/watch?v=SYcaOhR0Ols","cita":"CORRIENTE ALTERNA  PSICÓPATA 1997.  MARACAIBO ZULIA  VENEZUELA"}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=SYcaOhR0Ols", "cita": "CORRIENTE ALTERNA  PSICÓPATA 1997.  MARACAIBO ZULIA  VENEZUELA"}, "ciudad": {"valor": "Maracaibo", "url": "https://www.youtube.com/watch?v=SYcaOhR0Ols", "cita": "CORRIENTE ALTERNA FUE UNA BANDA DE ROCK ALTERNATIVO, NACIDA EN MARACAIBO A MEDIADOS DE LOS 90´S."}, "año_formacion": null, "generos": [{"genero": "Rock alternativo", "url": "https://www.youtube.com/watch?v=SYcaOhR0Ols", "cita": "CORRIENTE ALTERNA FUE UNA BANDA DE ROCK ALTERNATIVO"}, {"genero": "Psychodelic rock", "url": "https://soundcloud.com/corriente-alterna-1/sets/corriente-alterna", "cita": "# psychodelic rock"}], "datos_para_biografia": [{"dato": "Banda formada a mediados de los 90 en Maracaibo; entre sus integrantes estuvieron Roberto Jiménez (voz y guitarra), Alexander Hung (bajo y piano), Charles Masso (teclados y guitarra), Alejandro Morillo (guitarra), Leonardo Faria (batería), Remczy Márquez (guitarra), Dave Delgado, Eduardo Govea y Alexis Rojo (bajos).", "url": "https://www.youtube.com/watch?v=SYcaOhR0Ols", "cita": "CORRIENTE ALTERNA FUE UNA BANDA DE ROCK ALTERNATIVO, NACIDA EN MARACAIBO A MEDIADOS DE LOS 90´S. CONFORMADA POR VARIOS INTEGRANTES DE LOS CUALES FUERON: ROBERTO JIMÉNEZ, VOZ YGUITARRA, ALEXANDER HUNG, BAJO Y PIANO, CHARLES MASSO TECLADOS Y GUITARRA, ALEJANDRO MORILLO, GUITARRA, LEONARDO FARIA, BATERIA, REMCZY MARQUEZ, GUITARRA, DAVE DELGADO, BAJO, EDUARDO GOVEA, BAJO Y ALEXIS ROJO, BAJO."}, {"dato": "Su música se autodefine como «producto final resultante de la mala junta / good fellas haciendo rock and roll» y está etiquetada como maracaibo, rock, venezuela y zulia.", "url": "https://soundcloud.com/corriente-alterna-1/sets/corriente-alterna", "cita": "producto final resultante de la mala junta / good fellas haciendo rock and roll"}, {"dato": "Entre su material grabado figuran los temas «Viaje» (pista también atribuida al disco El Delicado Sonido del Rock - Volumen III, Maracaibo 2020) y «Avion» (coincidente con «1 Avión» de Venezuela Sin Fronteras, 1997).", "url": "https://soundcloud.com/corriente-alterna-1/sets/corriente-alterna", "cita": "Avion ... Cielo rojo ... Inerte ... Morse ... Pasar... ... Pirotecnia ... noche sin luz ... Sueño lisergico ... Viaje"}]}
