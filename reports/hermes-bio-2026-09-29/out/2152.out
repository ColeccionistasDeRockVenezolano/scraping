{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/cabimas-la-cuna-del-rock-compilado_23.html", "cita": "10. Diaclasa - Hipocrita Navidad"}, {"url": "https://www.youtube.com/watch?v=GKYMrp3yp0k", "cita": "ESTE TEMA NO FUE COMPILADO EN EL DISCO LEGADO, ES PARTE DE LA DISCOGRAFÍA DE DIACLASA. POWER METAL DE CABIMAS ESTADO ZULIA."}, {"url": "https://www.youtube.com/watch?v=KZyzwtYqrg0", "cita": "DIACLASA BANDA DE POWER-METAL AMERICANO ORIUNDO DE CABIMAS ESTADO ZULIA VENEZUELA. TEMA EXTRAIDO DEL COMPILADO \"LEGADOrOCK ZULIANO\"."}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=KZyzwtYqrg0", "cita": "DIACLASA BANDA DE POWER-METAL AMERICANO ORIUNDO DE CABIMAS ESTADO ZULIA VENEZUELA."}, "ciudad": {"valor": "Cabimas", "url": "https://www.youtube.com/watch?v=GKYMrp3yp0k", "cita": "POWER METAL DE CABIMAS ESTADO ZULIA."}, "año_formacion": null, "generos": [{"genero": "Power metal", "url": "https://www.youtube.com/watch?v=KZyzwtYqrg0", "cita": "DIACLASA BANDA DE POWER-METAL AMERICANO ORIUNDO DE CABIMAS ESTADO ZULIA VENEZUELA."}, {"genero": "Power metal", "url": "https://www.youtube.com/watch?v=GKYMrp3yp0k", "cita": "POWER METAL DE CABIMAS ESTADO ZULIA."}], "datos_para_biografia": [{"dato": "Su tema «Hipócrita Navidad» (1998) no fue incluido en el compilado «Legado Rock Zuliano», pero sí forma parte de la discografía oficial de la banda.", "url": "https://www.youtube.com/watch?v=GKYMrp3yp0k", "cita": "ESTE TEMA NO FUE COMPILADO EN EL DISCO LEGADO, ES PARTE DE LA DISCOGRAFÍA DE DIACLASA. POWER METAL DE CABIMAS ESTADO ZULIA."}, {"dato": "Participó con el tema «Psicoasesino» (2001) en el compilado «Legado Rock Zuliano».", "url": "https://www.youtube.com/watch?v=KZyzwtYqrg0", "cita": "TEMA EXTRAIDO DEL COMPILADO \"LEGADOrOCK ZULIANO\"."}, {"dato": "Aparece con el tema «Hipocrita Navidad» en «Compilado Zuliano Volumen III - Edición de Colección» (2020), de Cabimas La Cuna Del Rock, lanzado en Cabimas - Venezuela.", "url": "https://descargasmetalvenezolano.blogspot.com/2020/02/cabimas-la-cuna-del-rock-compilado_23.html", "cita": "G{enero: Hard/Heavy/Thrash/Black/Death/Hardcore... Lugar: Cabimas - Venezuela / 10. Diaclasa - Hipocrita Navidad"}]}
