{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/search?q=%22Filosof%C3%ADa+Barata%22", "cita": "Maracaibo - El Delicado Sonido del Rock - Volumen IV (2020) ... Lugar: Maracaibo - Venezuela ... Temas: 01. Filosofía Barata - No Estas"}, {"url": "https://soundcloud.com/filosofiabarata/noestas", "cita": "Filosofía Barata - No Estas ... # maracaibo # venezuela"}, {"url": "https://soundcloud.com/filosofiabarata", "cita": "Maracaibo, Bolivarian Republic of Venezuela"}], "pais": {"valor": "Venezuela", "url": "https://soundcloud.com/filosofiabarata", "cita": "Maracaibo, Bolivarian Republic of Venezuela"}, "ciudad": {"valor": "Maracaibo", "url": "https://soundcloud.com/filosofiabarata", "cita": "Maracaibo, Bolivarian Republic of Venezuela"}, "año_formacion": null, "generos": [{"genero": "Hard/Heavy/Thrash/Death/Black/Hardcore", "url": "https://descargasmetalvenezolano.blogspot.com/search?q=%22Filosof%C3%ADa+Barata%22", "cita": "Género: Hard/Heavy/Thrash/Death/Black/Hardcore..."}], "datos_para_biografia": [{"dato": "Integrantes: Renny Márquez (guitarra/voz/programación), Carlos Graterol (guitarra líder) y Breddy Galvis (bajo)", "url": "https://soundcloud.com/filosofiabarata", "cita": "Renny Márquez (guitarra/Voz/Programación) Carlos Graterol (Guitarra Lider) Breddy Galvis (Bass Guitar)"}, {"dato": "Descripción del proyecto según el propio grupo", "url": "https://soundcloud.com/filosofiabarata", "cita": "Este proyecto musical nació en las entrañas de la insonoridad de nuestras existencias, y nos vimos en la necesidad de crear sensaciones por medio de melodías que representan alguna vivencia de algún pasado, presente o futuro."}, {"dato": "Su tema «No Estas» abre como pista 01 la compilación de bandas de Maracaibo «El Delicado Sonido del Rock - Volumen IV» (2020)", "url": "https://descargasmetalvenezolano.blogspot.com/search?q=%22Filosof%C3%ADa+Barata%22", "cita": "Álbum: El Delicado Sonido del Rock - Volumen IV ... 01. Filosofía Barata - No Estas"}]}
