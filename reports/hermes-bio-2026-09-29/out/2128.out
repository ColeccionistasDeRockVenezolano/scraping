{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "VACTERIA se formó en Punto Fijo - Edo. Falcón, Venezuela, en el primer trimestre del año 2.000, integrada inicialmente por Erwin Rujano (Voz / Guitarra), Daniel Medina (Guitarra), David Medina (Bajo) y Jorge Khouri (Batería)."}, {"url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "saldria a la luz su 2do disco AMOR y ODIO 2004 sus temas son: SUFRIRAS POR MI, LA PRIMERA Y ULTIMA VEZ, AUNQUE YA NO TE VUELVA A VER, SIGUE LA CORRIENTE, A TU LADO, ANTISOCIAL, TIEMPO AL TIEMPO, ME OLVIDASTES, SOLO, NO HABLES, TU LO MATASTES, GANAS DE MORIR, DEL CIELO AL INFIERNO, EL GORDO, ESTERIL, TIEMPO AL TIEMPO (ACUSTICO) y MI SOLEDAD"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock.html", "cita": "28. Vacteria - No Hables"}, {"url": "https://www.youtube.com/channel/UC-uJByd08Z5Fer_b2v200Ug/videos", "cita": "Vacteria Banda Punto fijo Estado Falcón Venezuela"}], "pais": {"valor": "Venezuela", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "VACTERIA se formó en Punto Fijo - Edo. Falcón, Venezuela, en el primer trimestre del año 2.000"}, "ciudad": {"valor": "Punto Fijo", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "VACTERIA se formó en Punto Fijo - Edo. Falcón, Venezuela, en el primer trimestre del año 2.000"}, "año_formacion": {"valor": 2000, "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "se formó en Punto Fijo - Edo. Falcón, Venezuela, en el primer trimestre del año 2.000"}, "generos": [{"genero": "Punk callejero", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "lograron terminar los 12 temas de punk callejero con mucha potencia y melodiasde su primer trabajo \"VACTERIA\""}], "datos_para_biografia": [{"dato": "Formación inicial: Erwin Rujano (voz/guitarra), Daniel Medina (guitarra), David Medina (bajo) y Jorge Khouri (batería).", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "integrada inicialmente por Erwin Rujano (Voz / Guitarra), Daniel Medina (Guitarra), David Medina (Bajo) y Jorge Khouri (Batería)"}, {"dato": "Su primer trabajo independiente \"VACTERIA\" (12 temas) fue seguido en 2004 por el segundo disco \"AMOR y ODIO\" (17 temas), que incluye el tema «No Hables».", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "Pasarian 2 años mas para que la banda volviera a grabar su proximo trabajo con 17 temas saldria a la luz su 2do disco AMOR y ODIO 2004"}, {"dato": "Fue reconocida a nivel regional y compartió escenario con Amnesia, Sarna (Caracas), Morbus, Gamaliel y La Mosca Punk (Coro).", "url": "https://rockparaguana.blogspot.com/2012/07/vacteria.html", "cita": "Con este disco el grupo seria reconocido a nivel regional como uno de los mejores de la ciudad, compartiendo tarima con Amnesia, Sarna (Caracas), Morbus, Gamaliel, La Mosca Punk (Coro), entre otros."}]}
