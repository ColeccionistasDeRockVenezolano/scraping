{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2019/12/banda-ciudad-ojeda-es-rock-album.html", "cita": "08. K.A.F.C. - Me Niego a Morir"}, {"url": "https://www.youtube.com/watch?v=ULSX0Rm7EII", "cita": "K A F C - ME NIEGO A MORIR. CIUDAD OJEDA - ZULIA 2000."}, {"url": "https://www.youtube.com/watch?v=ULSX0Rm7EII", "cita": "BANDA UNDERGROUND QUE A PASADO POR  UNA METAMORFOSIS MUSICAL, HOY DOS DE SUS MIEMBROS CONFORMAN LA BANDA AURORA."}, {"url": "https://www.youtube.com/watch?v=Kg2kLb3D5C0", "cita": "K.A.F.C.  FUERON UNA BANDA DE PUNK DE FINALES DE LOS 90´S.  DONDE PARTICIPARON ROCKEROS DE RENOMBRES EN NUESTRA REGIÓN EL LICENCIADO EN LETRAS EL PANA EDUARDO PEPPER, ABRAHAN VERDE BATERISTA DE AURORA, MERVIN Y LUIS."}, {"url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "K.A.F.C. TEDIO. ESTA BANDA ZULIA DE CIUDAD OJEDA TUVO MUCHAS METAMORFOSIS O CAMBIOS DE NOMBRE. LLEGARON A LLAMARSE EPILEPSIA, LUEGO PASARON A SER LOS CHICOS DEL LIBRO VERDE, PARA LUEGO LLAMARSE K.A.F.C."}], "pais": {"valor": "Venezuela", "url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "K A F C TEDIO DEMO ACCIDENTADO Y TRÁGICO. CIUDAD OJEDA. VZLA."}, "ciudad": {"valor": "Ciudad Ojeda", "url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "ESTA BANDA ZULIA DE CIUDAD OJEDA TUVO MUCHAS METAMORFOSIS O CAMBIOS DE NOMBRE."}, "año_formacion": null, "generos": [{"genero": "punk", "url": "https://www.youtube.com/watch?v=Kg2kLb3D5C0", "cita": "K.A.F.C.  FUERON UNA BANDA DE PUNK DE FINALES DE LOS 90´S."}], "datos_para_biografia": [{"dato": "Antes de llamarse K.A.F.C. la banda pasó por los nombres Epilepsia y Los Chicos del Libro Verde.", "url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "LLEGARON A LLAMARSE EPILEPSIA, LUEGO PASARON A SER LOS CHICOS DEL LIBRO VERDE, PARA LUEGO LLAMARSE K.A.F.C."}, {"dato": "Su formación: Eduardo Pepper «El Choro» (voz, licenciado en letras) y Abrahan Verde (batería); también pasaron Mervin y Luis; dos de sus miembros integraron después la banda Aurora.", "url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "EDUARDO PEPER VOZ, ABRAHAN VERDE BATERIA."}, {"dato": "Grabaron su demo «Tedio» en vivo en un estudio casero el mismo día en que La Skoria grababa el suyo; en esa jornada un incendio en la casa del vocalista quemó los instrumentos de la banda.", "url": "https://www.youtube.com/watch?v=s6LQs9fcVX8", "cita": "ESTA PRODUCCIÓN FUE GRABADA EN VIVO EN UN ESTUDIO CASERO. ESE MISMO DÍA GRABA SU DEMO LA AGRUPACIÓN LA SKORIA."}]}
