{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "09. ENKANTEN MORT - Ciudad Cementerio 3:29"}, {"url": "https://rockhechovzla.blogspot.com/2020/01/metalkinesia-capitulo-trujillo.html", "cita": "las corrientes del black y death metal (AVERNO, ENKANTEN MORT, DYING FOR REDEMPTION)"}, {"url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "de Trujillo Averno (Black Metal), Enkanten Mort (Black Gothic Metal), Luxor (Black Metal)"}, {"url": "https://fotogramasypalabras.blogspot.com/2011/04/el-metal-extremo-predomina-en-los.html", "cita": "Enkanten Mort y Averno, enfocadas en el Black Metal"}], "pais": {"valor": "Venezuela", "url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "Romina (Enkanten Mort).Asistan a los toques de ustedes depende la movida rockera venezolana"}, "ciudad": {"valor": "Trujillo", "url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "El concierto Andes extremo será este sábado 16 de agosto de 2008 a las 5 pm en el Club Brisas del Río en el Municipio Pampanito del Estado Trujillo, costo de la entrada: BsF. 12 P/P. Las Bandas q tocarán son las siguientes: desde Mérida una banda muy conocida de Death Metal: Subconsciente, de Trujillo Averno (Black Metal), Enkanten Mort (Black Gothic Metal), Luxor (Black Metal)"}, "año_formacion": null, "generos": [{"genero": "Black Metal", "url": "https://fotogramasypalabras.blogspot.com/2011/04/el-metal-extremo-predomina-en-los.html", "cita": "Enkanten Mort y Averno, enfocadas en el Black Metal"}, {"genero": "Black Gothic Metal", "url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "Enkanten Mort (Black Gothic Metal)"}, {"genero": "Black/Death Metal", "url": "https://rockhechovzla.blogspot.com/2020/01/metalkinesia-capitulo-trujillo.html", "cita": "las corrientes del black y death metal (AVERNO, ENKANTEN MORT, DYING FOR REDEMPTION)"}], "datos_para_biografia": [{"dato": "En 2008 la banda figuraba en el cartel del concierto 'Andes extremo' en el Club Brisas del Río (Municipio Pampanito, Estado Trujillo), junto a Subconsciente, Averno, Luxor y Difuntos", "url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "El concierto Andes extremo será este sábado 16 de agosto de 2008 a las 5 pm en el Club Brisas del Río en el Municipio Pampanito del Estado Trujillo"}, {"dato": "Su tema 'Ciudad Cementerio' (3:29) integra el compilatorio Metalkinesia - Capítulo Trujillo (2020), editado en homenaje a Ángel Uzcátegui", "url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "09. ENKANTEN MORT - Ciudad Cementerio 3:29"}, {"dato": "Una integrante identificada como Romina firmaba la difusión de los conciertos de la banda", "url": "https://caracasgotica.blogspot.com/2008/08/extremo.html", "cita": "Romina (Enkanten Mort)"}]}
