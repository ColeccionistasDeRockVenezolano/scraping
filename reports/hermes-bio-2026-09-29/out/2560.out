{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Anaal Nathrakh are a British extreme metal band formed in 1999 in Birmingham by multi-instrumentalist Mick Kenney and vocalist Dave Hunt."}, {"url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "The duo recorded two demos before their first full album, The Codex Necro, in 2001"}, {"url": "https://musicbrainz.org/search?query=Anaal+Nathrakh&type=artist&method=indexed", "cita": "Anaal Nathrakh (British extreme metal band)"}], "pais": {"valor": "United Kingdom", "url": "https://musicbrainz.org/search?query=Anaal+Nathrakh&type=artist&method=indexed", "cita": "United Kingdom"}, "ciudad": {"valor": "Birmingham", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "formed in 1999 in Birmingham by multi-instrumentalist Mick Kenney and vocalist Dave Hunt"}, "año_formacion": {"valor": 1999, "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Years active 1999–present"}, "generos": [{"genero": "blackened death metal", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Blackened death metal· grindcore· industrial metal"}, {"genero": "grindcore", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Blackened death metal· grindcore· industrial metal"}, {"genero": "industrial metal", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Blackened death metal· grindcore· industrial metal"}], "datos_para_biografia": [{"dato": "Anaal Nathrakh are a British extreme metal band formed in 1999 in Birmingham by multi-instrumentalist Mick Kenney and vocalist Dave Hunt.", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "Anaal Nathrakh are a British extreme metal band formed in 1999 in Birmingham by multi-instrumentalist Mick Kenney and vocalist Dave Hunt."}, {"dato": "The band's name is Irish for \"snake's breath\" (anál nathrach) and was taken from Merlin's Charm of Making in John Boorman's 1981 film Excalibur.", "url": "https://en.wikipedia.org/wiki/Anaal_Nathrakh", "cita": "The band's name is Irish for \"snake's breath\" (anál nathrach) and was taken from Merlin's Charm of Making in John Boorman's 1981 film Excalibur."}, {"dato": "Su primer álbum de estudio, The Codex Necro, es de 2001 (pista remezclada por Zardonic).", "url": "https://musicbrainz.org/search?query=Anaal+Nathrakh&type=artist&method=indexed", "cita": "The Codex Necro"}]}
