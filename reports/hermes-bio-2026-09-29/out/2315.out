{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "08. MEDUZA - Universo 3:55"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "Banda: Metalkinesia (V/A) Álbum: Capitulo Trujillo Lanzamiento: 2020 Género: Hard/Heavy/Thrash/Death/Black/Hardcore/Punk... Lugar: Trujillo - Venezuela"}, {"url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "La banda Trujillana «Meduza», nace a comienzo del 2013, integrada por cuatro músicos con diferentes influencias musicales. Sin embargo, el hard rock se convierte en el principal actor como punto de equilibrio."}, {"url": "https://soundcloud.com/meduzabanda/meduza-requiem-en-directo", "cita": "MEDUZA Música y Letra: ROBERTO PINTO. Reservados todos los derechos. Trujillo, Venezuela 2013."}], "pais": {"valor": "Venezuela", "url": "https://soundcloud.com/meduzabanda/meduza-requiem-en-directo", "cita": "Trujillo, Venezuela 2013."}, "ciudad": {"valor": "Trujillo", "url": "https://soundcloud.com/meduzabanda/meduza-requiem-en-directo", "cita": "Trujillo, Venezuela 2013."}, "año_formacion": {"valor": 2013, "url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "La banda Trujillana «Meduza», nace a comienzo del 2013"}, "generos": [{"genero": "Hard rock", "url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "el hard rock se convierte en el principal actor como punto de equilibrio"}, {"genero": "Rock & Roll", "url": "https://soundcloud.com/meduzabanda/meduza-requiem-en-directo", "cita": "Rock & Roll"}], "datos_para_biografia": [{"dato": "Banda trujillana de hard rock formada a comienzos de 2013 por cuatro músicos de distintas influencias.", "url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "La banda Trujillana «Meduza», nace a comienzo del 2013, integrada por cuatro músicos con diferentes influencias musicales."}, {"dato": "Alineación: Roberto Pinto (voz), Gabo Guerrero (guitarra líder), Chemel Noguera (bajo) y Lucho Vázquez (batería).", "url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "Robert Pinto/Vocalista Gabo Guerrero/Guitarra Lider; Chemel Norguera/Bajo Lucho Vazquez/ Batería."}, {"dato": "Consolidaron 12 temas inéditos, de los cuales 4 salieron en su primer EP.", "url": "https://paltoque.com/noticia-meduza-lanza-su-primer-ep/", "cita": "logrando así consolidar (12) temas inéditos, dando paso a (4) de ellos para el lanzamiento de su primer EP"}]}
