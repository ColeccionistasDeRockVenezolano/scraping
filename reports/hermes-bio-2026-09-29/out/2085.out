{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/03/maracaibo-el-delicado-sonido-del-rock_54.html", "cita": "16. Sisrema Diez - Complices del Cinismo"}, {"url": "https://sistemadiez.bandcamp.com/album/todos-sospechosos", "cita": "Cómplices del Cinismo 02:26"}], "pais": {"valor": "Venezuela", "url": "https://lacarnemagazine.com/sistema-diez-metal-hardcore-venezolano/", "cita": "Nuestro origen es Venezuela, tierra sudamericana llena de muchos matices y gente cálida."}, "ciudad": {"valor": "Maracaibo", "url": "https://sistemadiez.bandcamp.com/album/todos-sospechosos", "cita": "Banda de Metal fundada en el 2007 en Maracaibo, Venezuela!"}, "año_formacion": {"valor": 2007, "url": "https://lacarnemagazine.com/sistema-diez-metal-hardcore-venezolano/", "cita": "El proyecto nace en 2007"}, "generos": [{"genero": "Metal Hardcore", "url": "https://lacarnemagazine.com/sistema-diez-metal-hardcore-venezolano/", "cita": "Sistema Diez, Metal Hardcore venezolano"}, {"genero": "Thrash", "url": "https://sistemadiez.bandcamp.com/album/todos-sospechosos", "cita": "thrash"}, {"genero": "Punk", "url": "https://lacarnemagazine.com/sistema-diez-metal-hardcore-venezolano/", "cita": "desde las bandas clásicas del Metal, pasando por el Punk, el Hardcore, incluso ritmos tradicionales venezolanos."}], "datos_para_biografia": [{"dato": "Fundada en 2007 en Maracaibo, Venezuela; hoy radicada en Buenos Aires, Argentina.", "url": "https://sistemadiez.bandcamp.com/album/todos-sospechosos", "cita": "Banda de Metal fundada en el 2007 en Maracaibo, Venezuela!"}, {"dato": "El tema «Cómplices del Cinismo» integra su álbum «Todos Sospechosos» (2016).", "url": "https://sistemadiez.bandcamp.com/album/todos-sospechosos", "cita": "se lanzó el 9dejuniode2016"}, {"dato": "Migró de Venezuela a Argentina y plasmó esa experiencia en su EP «Contra Todo Pronóstico».", "url": "https://lacarnemagazine.com/sistema-diez-metal-hardcore-venezolano/", "cita": "Empezamos con la pre-producción en el 2017, ya teniendo en mente que nos mudaríamos a Buenos Aires, Argentina."}]}
