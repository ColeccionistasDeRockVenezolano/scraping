{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=3AiND4nQ3PM", "cita": "Héloïse - Tus Días Sin Mí (Vídeo Oficial)"}, {"url": "https://www.youtube.com/watch?v=3AiND4nQ3PM", "cita": "REVERDECER EP: Tus días sin mí // Más información en:https://www.instagram.com/heloise_band/ https://www.facebook.com/heloisemedel..."}, {"url": "https://lacarnemagazine.com/heloise-banda-redefine-metal-moderno/", "cita": "Inicialmente sacamos un primer EP al que titulamos Reverdecer EP."}], "pais": {"valor": "Colombia", "url": "https://colectivosonoro.com/2023/06/heloise-se-abre-paso-en-la-escena-del-metal-con-una-propuesta-estilizada-sobre-la-creacion-y-caos/", "cita": "Héloïse, banda de metal de Medellín, Colombia, que presenta un sencillo llamado Pilares de la destrucción"}, "ciudad": {"valor": "Medellín", "url": "https://colectivosonoro.com/2023/06/heloise-se-abre-paso-en-la-escena-del-metal-con-una-propuesta-estilizada-sobre-la-creacion-y-caos/", "cita": "Héloïse, banda de metal de Medellín, Colombia, que presenta un sencillo llamado Pilares de la destrucción"}, "año_formacion": {"valor": 2014, "url": "https://hagalau.net/5-datos-claves-de-pilares-de-la-destruccion-nuevo-videoclip-de-heloise/", "cita": "Nacidos en 2014, Héloïse recoge elementos del metal core en su sonido."}, "generos": [{"genero": "metal", "url": "https://colectivosonoro.com/2023/06/heloise-se-abre-paso-en-la-escena-del-metal-con-una-propuesta-estilizada-sobre-la-creacion-y-caos/", "cita": "Héloïse, banda de metal de Medellín, Colombia, que presenta un sencillo llamado Pilares de la destrucción"}, {"genero": "metalcore", "url": "https://colectivosonoro.com/2023/06/heloise-se-abre-paso-en-la-escena-del-metal-con-una-propuesta-estilizada-sobre-la-creacion-y-caos/", "cita": "la voz en Pilares de la destrucción entra con un tono fuerte y gutural, que se para en una línea delgada entre el Metalcore y al Death Metal."}, {"genero": "metal moderno", "url": "https://lacarnemagazine.com/heloise-banda-redefine-metal-moderno/", "cita": "Su propuesta musical se puede catalogar como un metal moderno, pero encontramos sonoridades de otras tendencias."}], "datos_para_biografia": [{"dato": "El nombre de la banda proviene de la bisabuela del guitarrista y corista Andrés Peña, como homenaje a la figura materna.", "url": "https://lacarnemagazine.com/heloise-banda-redefine-metal-moderno/", "cita": "Bueno, el nombre de la banda viene de mi bisabuela."}, {"dato": "Integran el sello y productora colombiana AP Records.", "url": "https://lacarnemagazine.com/heloise-banda-redefine-metal-moderno/", "cita": "Ustedes pertenecen al sello y productora colombiana AP Records."}, {"dato": "Han participado en el cartel del Altavoz Fest en las ediciones 2018 y 2019.", "url": "https://hagalau.net/5-datos-claves-de-pilares-de-la-destruccion-nuevo-videoclip-de-heloise/", "cita": "Han integrado el cartel de Altavoz Fest en las ediciones 2018 y 2019"}]}
