{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.sincopa.com/rock_pop/cdinfo_rock/compilations1/ccs_high_tech.htm", "cita": "10- 3589 (Rafael L. Garnica) 9:05  Performed by Rafael L. Garnica"}, {"url": "https://rockhechovenezuela.com/g/garnica/", "cita": "Rafael López Garnica (guitarra, batería, percusión, teclados, programación, voz) es un músico merideño que desde temprana edad ha manifestado sus inquietudes y talento musical."}, {"url": "https://www.instagram.com/p/DDX3jLyhqKu/", "cita": "Rafael Garnica músico y productor fundador de los Andes electrónicos, gran personaje de la música en Venezuela"}], "pais": {"valor": "Venezuela", "url": "https://www.instagram.com/p/DDX3jLyhqKu/", "cita": "Rafael Garnica músico y productor fundador de los Andes electrónicos, gran personaje de la música en Venezuela"}, "ciudad": {"valor": "Mérida", "url": "https://www.aboutgarnica.com/music/submarino", "cita": "Submarino is a music project formed in Mérida in 1999 by Andrés Sosa (5053x), César Sosa, and Rafael López Garnica."}, "año_formacion": {"valor": 1999, "url": "https://www.aboutgarnica.com/music/submarino", "cita": "Submarino is a music project formed in Mérida in 1999 by Andrés Sosa (5053x), César Sosa, and Rafael López Garnica."}, "generos": [{"genero": "música electrónica", "url": "https://rockhechovenezuela.com/g/garnica/", "cita": "Paralelo a su actividad con Submarino, Garnica comienza a desarrollar su carrera como solista orientándose hacia las tendencias de música electrónica."}, {"genero": "rock / trip-hop", "url": "https://www.aboutgarnica.com/music/submarino", "cita": "The band combined elements of rock, trip-hop, and influences from the British alternative scene, developing a distinctive sound for its time."}], "datos_para_biografia": [{"dato": "Músico merideño multiinstrumentista: guitarra, batería, percusión, teclados, programación y voz.", "url": "https://rockhechovenezuela.com/g/garnica/", "cita": "Rafael López Garnica (guitarra, batería, percusión, teclados, programación, voz) es un músico merideño que desde temprana edad ha manifestado sus inquietudes y talento musical."}, {"dato": "Con la agrupación Submarino ganó el Festival Nuevas Bandas 2000 y grabó el álbum Submarino (2001).", "url": "https://rockhechovenezuela.com/g/garnica/", "cita": "Con esta agrupacións gana el Festival Nuevas Bandas 2000 y graba el álbum Submarino (2001)."}, {"dato": "Fundador del colectivo Los Andes Electrónicos, con la banda Submarino junto a los hermanos Sosa.", "url": "https://www.instagram.com/p/DDX3jLyhqKu/", "cita": "Rafael Garnica músico y productor fundador de los Andes electrónicos, gran personaje de la música en Venezuela, su banda @submarino2001 junto a los hermanos Sosa es referente en su estilo"}]}
