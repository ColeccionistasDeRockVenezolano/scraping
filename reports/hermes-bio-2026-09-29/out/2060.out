{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://soundcloud.com/ainhoaband/ainhoa-cuando-me-preguntan-por-ti", "cita": "Demo de nuestro primer sencillo, producido por Naxxo Matéis (Maxxistudios Ccs). ¡Esperamos que les guste!."}, {"url": "https://www.youtube.com/watch?v=kRSf4qwAhps", "cita": "Estos participantes del Festival Nuevas Bandas 2015, son los protagonistas del tercer capítulo de la nueva temporada de las Sesiones Ñ de Rock en Ñ"}, {"url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "Promocionándola con el videoclip de su primer single “Cuando me preguntan por ti”, dirigido por Henry Ramírez de Capibara Films."}], "pais": {"valor": "Venezuela", "url": "https://soundcloud.com/ainhoaband", "cita": "Banda de Rock/Indie/Alternativo de Mérida, Venezuela. Follow us!"}, "ciudad": {"valor": "Mérida", "url": "https://soundcloud.com/ainhoaband", "cita": "Banda de Rock/Indie/Alternativo de Mérida, Venezuela. Follow us!"}, "año_formacion": {"valor": 2012, "url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "Consolidada tan solo a mediados del año 2012 en El Vigía. Edo. Mérida."}, "generos": [{"genero": "Indie Rock con matices de Brit Pop", "url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "Es una banda de Indie Rock con matices de Brit Pop."}, {"genero": "Rock con influencia del indie británico y guiños al shoegaze", "url": "https://www.youtube.com/watch?v=kRSf4qwAhps", "cita": "una banda que practica un Rock con influencia del indie británico y claros guiños al shoegaze en sus guitarras."}, {"genero": "Rock/Indie/Alternativo", "url": "https://soundcloud.com/ainhoaband", "cita": "Banda de Rock/Indie/Alternativo de Mérida, Venezuela. Follow us!"}], "datos_para_biografia": [{"dato": "Integrantes: Samuel Morales (voz y guitarra), Pedro Duque Rangel (guitarra principal), Gabriel Rozo (batería) y Héctor Moreno (bajo).", "url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "Integrantes: Samuel Morales; Voz y Guitarra. Pedro Duque Rangel. Guitarra Principal. Gabriel Rozo. Batería. Héctor Moreno: Bajo."}, {"dato": "Su primer single fue «Cuando me preguntan por ti», con videoclip dirigido por Henry Ramírez (Capibara Films) y producción bajo dirección musical de Nacho Mateis (Maxi Studios Caracas).", "url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "bajo la Dirección Musical y patrocinio de Nacho Mateis de Maxi Studios Caracas. Promocionándola con el videoclip de su primer single “Cuando me preguntan por ti”, dirigido por Henry Ramírez de Capibara Films."}, {"dato": "Participó en festivales como Rock Andes Fest, Visión Fest y la IV Guerra de Bandas, donde obtuvo el primer lugar.", "url": "https://fundaciondhyana.weebly.com/ainhoa.html", "cita": "con destacada participación en importantes festivales locales como Rock Andes Fest (Primeros Finalistas), Visión Fest y la IV Guerra de Bandas (Primer Lugar)."}]}
