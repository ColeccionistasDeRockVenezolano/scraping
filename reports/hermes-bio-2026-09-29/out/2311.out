{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "Banda: Metalkinesia (V/A) Álbum: Capitulo Trujillo Lanzamiento: 2020 Género: Hard/Heavy/Thrash/Death/Black/Hardcore/Punk... Lugar: Trujillo - Venezuela Temas: ... 03. AVERNO - Una Lagrima de Sangre 2:59"}, {"url": "https://www.youtube.com/watch?v=lIC3_kMXCvY", "cita": "Banda: Averno\nLugar:Trujillo Venezuela\nAño: 2008 \nIntegrantes:\nVanessa Fernandes ( Hecate ): Voces\nSamuel Teran ( Samael ): Guitarra\nJuan Espinoza ( Buho ): Bajo\nRichard Rivas ( Astaroth ): Bateria\nCancion del demo homonimo de Averno grabado de la mano de ``Bring the Mosh Producciones´´ nos trae un Black Metal mas novedoso a mas de lo mismo que se venia haciendo en la epoca"}, {"url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "AVERNO \nGenero: \nBlack Metal \nPaís: Venezuela \nEstado: Trujillo \nCiudad: Trujillo \nComienzos: \nEn Diciembre Del 2006 se decide crear en el Estado Trujillo un proyecto experimental de Death Black creado por el Juan Espinoza y Samuel Terán."}], "pais": {"valor": "Venezuela", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "País: Venezuela"}, "ciudad": {"valor": "Trujillo", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "Ciudad: Trujillo"}, "año_formacion": {"valor": 2006, "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "En Diciembre Del 2006 se decide crear en el Estado Trujillo un proyecto experimental de Death Black creado por el Juan Espinoza y Samuel Terán."}, "generos": [{"genero": "Black Metal", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "AVERNO \nGenero: \nBlack Metal"}, {"genero": "Metal Negro Venezolano", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "A mediados del 2007 se consolida como una Banda de Metal Negro Venezolano con su Segunda Alineación integrada por: Juan Espinoza (Búho-Bajo). Samuel Terán (Samael-guitarra). Vanessa Fernández (Hecate-Voz). Rafael Benítez (Batería). Isabel Matheus (Isa-Teclados)."}, {"genero": "Black Metal", "url": "https://www.youtube.com/watch?v=lIC3_kMXCvY", "cita": "nos trae un Black Metal mas novedoso a mas de lo mismo que se venia haciendo en la epoca, con unos cambios de compases intersantes y el uso de cromatismos que encajan perfectamente con una letra apocaliptica"}], "datos_para_biografia": [{"dato": "Proyecto experimental de Death Black fundado en diciembre de 2006 por Juan Espinoza y Samuel Terán en el estado Trujillo; la primera alineación fue Juan Espinoza (Búho-bajo), Samuel Terán (Samael-guitarra), Walter Fuentes (Dr. Gore-voces) y Ender (guitarra).", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "En Diciembre Del 2006 se decide crear en el Estado Trujillo un proyecto experimental de Death Black creado por el Juan Espinoza y Samuel Terán. \nLa primera alineación: Juan Espinoza (Búho-Bajo) Samuel Terán (Samael-guitarra). Walter Fuentes (Dr. Gore- Voces). Ender (Guitarra)."}, {"dato": "A mediados de 2007 se consolida como banda de metal negro con segunda alineación que incorpora a Vanessa Fernández (Hecate) en la voz; sus influencias declaradas son Immortal, Dark Funeral, Emperor, Ancient, Mayhem y Dimmu Borgir.", "url": "https://www.facebook.com/elolordelmuerto/posts/averno-genero-black-metal-pa%C3%ADs-venezuela-estado-trujillo-ciudad-trujillo-comienz/875471219178870/", "cita": "A mediados del 2007 se consolida como una Banda de Metal Negro Venezolano con su Segunda Alineación integrada por: Juan Espinoza (Búho-Bajo). Samuel Terán (Samael-guitarra). Vanessa Fernández (Hecate-Voz). Rafael Benítez (Batería). Isabel Matheus (Isa-Teclados).\nActual Alineación: Vanessa Fernández (Hecate-Voz). Juan Espinoza (Búho-Bajo). Richard Ribas (Astaroth -Batería). Ramón Briceño (Cheklem- Guitarra)\nInfluencia: IMMORTAL,DARK FUNERAL,EMPEROR,ANCIENT,MAYHEM,DIMMU BORGIR"}, {"dato": "Su tema «Una Lágrima de Sangre» (2:59) abre el tercer corte del compilado «Metalkinesia - Capitulo Trujillo» (2020), junto a bandas del estado Trujillo como Morfina, Abdias, Asphixia o Luxor; el tema proviene de su demo homónimo grabado con Bring the Mosh Producciones.", "url": "https://descargasmetalvenezolano.blogspot.com/2020/02/metalkinesia-capitulo-trujillo-2020.html", "cita": "Lanzamiento: 2020 Género: Hard/Heavy/Thrash/Death/Black/Hardcore/Punk... Lugar: Trujillo - Venezuela Temas: 01. MORFINA - Holocausto Cannibal (Solución Final) 2:49 02. ABDIAS - Consecuencias 3:32 03. AVERNO - Una Lagrima de Sangre 2:59 04. ASPHIXIA - Sistema Corrosivo 2:19"}]}
