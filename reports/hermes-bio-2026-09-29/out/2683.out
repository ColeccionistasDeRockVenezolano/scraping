{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.youtube.com/watch?v=PqJdaDy57n0", "cita": "Various Artists - Festival Nuevas Bandas 20 Años En Vivo (2010) || Full Album || ... 05. Jorge Spiteri Banda - Medley Aldemaro Romero"}, {"url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "Jorge Spiteri (Caracas, Venezuela; 2 de mayo de 1951-Carolina del Norte, Estados Unidos; 24 de mayo de 2020) fue un músico multi instrumentista venezolano, que ha sido considerado junto a su hermano fallecido Charles Spiteri, pionero de la música rock de Venezuela."}, {"url": "https://es.wikipedia.org/wiki/Festival_Nuevas_Bandas", "cita": "Sunplash, Alfombra Roja, Viniloversus, Los Mentas, Jorge Spiteri y su Bungaloo, Los Humanoides"}, {"url": "https://www.youtube.com/watch?v=QXPMaYM7cxE", "cita": "Spiteri - or 'the snake record', as it was known in Venezuela in 1973 - became a cult record for Venezuela's rock."}], "pais": {"valor": "Venezuela", "url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "Jorge Spiteri (Caracas, Venezuela; 2 de mayo de 1951-Carolina del Norte, Estados Unidos; 24 de mayo de 2020)"}, "ciudad": {"valor": "Caracas", "url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "Nacimiento: 2 de mayo de 1951 Caracas (Venezuela)"}, "año_formacion": null, "generos": [{"genero": "rock", "url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "pionero de la música rock de Venezuela"}, {"genero": "fusion rock", "url": "https://www.youtube.com/watch?v=QXPMaYM7cxE", "cita": "They were Venezuelans recording in Europe and making fusion rock that hadn't been heard before"}, {"genero": "latin jazz psych rock", "url": "https://www.youtube.com/watch?v=QXPMaYM7cxE", "cita": "Spiteri - Spiteri (1973 venezuela, latin jazz psych rock)Full Album"}], "datos_para_biografia": [{"dato": "Junto a su hermano Charles formó la banda Spiteri; su álbum homónimo de 1973 ('the snake record') es un disco de culto del rock venezolano.", "url": "https://www.youtube.com/watch?v=QXPMaYM7cxE", "cita": "brothers Charles and Jorge Spiteri decided to move to London at the start of the 70s and try their luck as musicians."}, {"dato": "Fundó las bandas Mañana y Los Buitres; fue cantante, compositor, productor y arreglista.", "url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "Fue fundador de los grupos Mañana y Los Buitres."}, {"dato": "Falleció el 24 de mayo de 2020 en Carolina del Norte (EE. UU.), a los 69 años.", "url": "https://es.wikipedia.org/wiki/Jorge_Spiteri", "cita": "Falleció el 24 de mayo de 2020, a los sesenta y nueve años, en Carolina del Norte (Estados Unidos) durante una visita familiar a causa de un cáncer."}]}
