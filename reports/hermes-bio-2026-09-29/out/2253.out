{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.oidossucios.com/site/ohmio-gana-el-4to-festival-de-rock-100-venezolano/", "cita": "9.- DCT Project – En este País – Valencia"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2020/04/festival-de-rock-100-venezolano-4to.html", "cita": "08. DCT - Project En este País (Enrique Sarabia)"}], "pais": {"valor": "Venezuela", "url": "https://descargasmetalvenezolano.blogspot.com/2020/04/festival-de-rock-100-venezolano-4to.html", "cita": "Lugar: Carabobo - Venezuela"}, "ciudad": {"valor": "Valencia", "url": "https://www.oidossucios.com/site/ohmio-gana-el-4to-festival-de-rock-100-venezolano/", "cita": "9.- DCT Project – En este País – Valencia"}, "año_formacion": null, "generos": [], "datos_para_biografia": [{"dato": "La banda DCT Project interpretó «En este País» en el 4to Festival de Rock 100% Venezolano, celebrado en Valencia y cerrado el 12 de octubre de 2003, quedando en el puesto 9 de la clasificación final del evento.", "url": "https://www.oidossucios.com/site/ohmio-gana-el-4to-festival-de-rock-100-venezolano/", "cita": "9.- DCT Project – En este País – Valencia"}, {"dato": "El tema aparece como pista 8 del compilado «Festival de Rock 100% Venezolano - 4to Compilado (2003)», acreditado como «DCT - Project En este País (Enrique Sarabia)».", "url": "https://descargasmetalvenezolano.blogspot.com/2020/04/festival-de-rock-100-venezolano-4to.html", "cita": "08. DCT - Project En este País (Enrique Sarabia)"}, {"dato": "El festival exigía a los participantes tocar una versión de una canción del folklore nacional; en él participaron agrupaciones de todo el país.", "url": "https://www.oidossucios.com/site/ohmio-gana-el-4to-festival-de-rock-100-venezolano/", "cita": "Durante más de 2 semanas, agrupaciones provenientes de todas partes del país, presentaron su repertorio junto a la versión de una canción del folklore nacional, requisito obligatorio para participar en el evento."}]}
