{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Miguel Noya (Caracas, 1956) es un músico y compositor venezolano de música electrónica. Pionero de la música electrónica venezolana junto con Oksana Linde, Ángel Rada y Vytas Brenner."}, {"url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "En 1984 lanza su primer LP, Gran Sabana, descrito como \"deep sci-fi-synthesis exploration\"."}, {"url": "https://api.discogs.com/releases/3498863", "cita": "\"artists\":[{\"name\":\"Miguel Noya\",\"anv\":\"Miguel A. Noya\",...}],\"title\":\"Gran Sabana\",\"country\":\"Venezuela\",\"released\":\"1984\",\"notes\":\"Hecho en Venezuela\\nLimited edition of 1000\""}, {"url": "https://api.discogs.com/artists/373906", "cita": "\"namevariations\":[\"Miguel A. Noya\",\"Miguel Angel Noya\",\"Miguel Ángel Noya\",\"Noya\"]"}], "pais": {"valor": "Venezuela", "url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Caracas, Venezuela"}, "ciudad": {"valor": "Caracas", "url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Miguel Noya (Caracas, 1956) es un músico y compositor venezolano de música electrónica"}, "año_formacion": {"valor": 1981, "url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Años activo: Desde 1981"}, "generos": [{"genero": "Música electrónica", "url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Género: Música electrónica"}, {"genero": "Electronic", "url": "https://api.discogs.com/releases/3498863", "cita": "\"genres\":[\"Electronic\",\"Folk, World, & Country\"]"}, {"genero": "Experimental / Tribal / Ambient", "url": "https://api.discogs.com/releases/3498863", "cita": "\"styles\":[\"Experimental\",\"Tribal\",\"Ambient\"]"}], "datos_para_biografia": [{"dato": "Pionero de la música electrónica venezolana", "url": "https://es.wikipedia.org/wiki/Miguel_Noya", "cita": "Pionero de la música electrónica venezolana junto con Oksana Linde, Ángel Rada y Vytas Brenner."}, {"dato": "Publ