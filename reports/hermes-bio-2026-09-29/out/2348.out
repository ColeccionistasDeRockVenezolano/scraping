{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://descargasmetalvenezolano.blogspot.com/2019/10/metalkinesia-capitulo-migracion-2019.html", "cita": "13. Pikawa (Ecuador) - Grita tu Rabia 2:44"}, {"url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "Grita Tu Rabia en su versión Demo es otra canción que pudimos disfrutar a volumen alto el momento de la presente redacción."}], "pais": {"valor": "Ecuador", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "Para todos los metalheads desde el mítico Quito en Ecuador, con todo su poder sonoro que emana del Centro del Mundo"}, "ciudad": {"valor": "Quito", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "nace en Quito, en el Valle de los Chillos, un grupo de amigos con ideas y gustos musicales -diferentes- decidimos formar esta banda"}, "año_formacion": {"valor": 2002, "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "ha celebrado 20 años desde su fundación en 2002"}, "generos": [{"genero": "Tribal Metal", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "La música Metal de la agrupación se caracteriza ahora por el gutural femenino, además del Tribal Metal, como ellos bien lo dicen."}], "datos_para_biografia": [{"dato": "Nace como homenaje a un jefe de la Tribu Pacarana", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "decidimos formar esta banda en homenaje a una historia que conocimos de uno de los últimos jefes de la Tribu Pacarana, cuyo principal objetivo era conservar sus tierras, no con la fuerza, sino demostrando que es un territorio ancestral y sustentable"}, {"dato": "Firmó con el sello independiente Arcanus Records", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "Pudimos fichar con Arcanus Records, una disquera Independiente que apostó por algunas bandas de la escena local. Era la primera vez que estábamos en un Estudio de esta magnitud y equipos, pero fue una experiencia por demás motivadora"}, {"dato": "Participó en el QuitoFest 2022", "url": "https://lacarnemagazine.com/pikawa-poderoso-sonido-tribal-metal/", "cita": "Los conocí en el QuitoFest 2022, y en su canal YouTube acaban de presentar un Mini Documental sobre su experiencia en este magno evento"}]}
