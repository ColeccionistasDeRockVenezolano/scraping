{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://soundcloud.com/robynchaos", "cita": "...collaborations with Bkey, \"The Suffering\" \"Lust\" remix, Audio & Dylan \"Rapture\", Zardonic & co \"Revolution\", and collaborations/remixes with The Panacea and Counterstrike on \"Thunderstatement\""}, {"url": "https://api.discogs.com/releases/3499875", "cita": "\"title\":\"Vulgar Display Of Bass\" ... \"tracklist\":[{\"position\":\"1\",...,\"artists\":[{...\"name\":\"Zardonic\"...},{...\"name\":\"Counterstrike\"...},{...\"name\":\"Gein\"...},{\"name\":\"Robyn Chaos\",\"anv\":\"Robyn Kaos\",...}],\"title\":\"Revolution\",\"duration\":\"4:56\"}"}, {"url": "https://musicbrainz.org/release/818661a9-d474-4577-92f7-cf715124000c", "cita": "1 Revolution — Zardonic, Counterstrike, Gein and Robyn Kaos (4:57)"}, {"url": "https://en.wikipedia.org/wiki/Freak_Recordings", "cita": "Artists include Dylan, Robyn Chaos, Audio, Limewax, Current Value, Counterstrike, Technical Itch, SPL, Basic Operations, Zardonic, Hedj, Forbidden Society, Kitech, Kantyze, and many more."}], "pais": null, "ciudad": {"valor": "London", "url": "https://soundcloud.com/robynchaos", "cita": "Therapy Sessions has risen from a midweek flagship event in London's East End to quickly become a major Dnb tour de force"}, "año_formacion": null, "generos": [{"genero": "Drum and Bass", "url": "https://soundcloud.com/robynchaos", "cita": "one of the main forces in darkcore, leftfield Drum and Bass/Crossbreed/Technoid"}, {"genero": "Crossbreed", "url": "https://soundcloud.com/robynchaos", "cita": "one of the main forces in darkcore, leftfield Drum and Bass/Crossbreed/Technoid"}, {"genero": "Technoid", "url": "https://soundcloud.com/robynchaos", "cita": "one of the main forces in darkcore, leftfield Drum and Bass/Crossbreed/Technoid"}, {"genero": "Darkcore", "url": "https://soundcloud.com/robynchaos", "cita": "one of the main forces in darkcore, leftfield Drum and Bass/Crossbreed/Technoid"}, {"genero": "Drum n Bass", "url": "https://api.discogs.com/releases/3499875", "cita": "\"genres\":[\"Electronic\"],\"styles\":[\"Drum n Bass\"]"}], "datos_para_biografia": [{"dato": "Nombre real: Robyn Scharaga; también acreditada como 'Robyn Kaos' (usado en el tema 'Revolution')", "url": "https://api.discogs.com/artists/242345", "cita": "\"name\": \"Robyn Chaos\", ... \"realname\": \"Robyn Scharaga\", \"namevariations\": [\"Robyn Kaos\"]"}, {"dato": "DJ, cantante, compositora y productora de drum and bass; principal organizadora de 'Therapy Sessions' Worldwide y fundadora/directora de la agencia Anger Management", "url": "https://soundcloud.com/robynchaos", "cita": "Chaos is the main organiser of \"Therapy Sessions\" Worldwide ... As Founder and Managing Director of the dark enthusiasts DJ Agency, Anger Management, she was instrumental in nurturing the long-term, successful careers of almost every major darkside Titan in today's DnB World you can think of."}, {"dato": "Desde 2011 dirige Therapy Sessions Recordings; integra el proyecto Faith in Chaos junto a su pareja Dylan y colaboró con Audio & Dylan y con Zardonic", "url": "https://soundcloud.com/robynchaos", "cita": "Since 2011, Chaos has been the head of Therapy Sessions Recordings, helping to fill the void left by Freak ... Chaos has produced, written and sang as part of the infamous Faith in Chaos outfit (alongside long term partner in grime, Dylan)"}]}
