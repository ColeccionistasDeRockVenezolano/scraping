{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://www.last.fm/search?q=Frequent+Traveling+DJ+Afro", "cita": "DJ Afro's Frequent Traveling Vol.1 — Los Mono"}, {"url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "durante el 2007 acaparó atención masiva gracias a la difusión internacional de su ingenioso video para el tema “Promesas”."}, {"url": "https://www.youtube.com/watch?v=OBSkLfVp2fQ", "cita": "Music Video from Chilean band Los Mono!"}], "pais": {"valor": "Chile", "url": "https://www.youtube.com/watch?v=OBSkLfVp2fQ", "cita": "Music Video from Chilean band Los Mono!"}, "ciudad": {"valor": "Santiago", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Santiago, 2004 - 2006"}, "año_formacion": {"valor": 2004, "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Santiago, 2004 - 2006"}, "generos": [{"genero": "Pop", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Pop, Hip-hop"}, {"genero": "Hip-hop", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Pop, Hip-hop"}], "datos_para_biografia": [{"dato": "Proyecto esporádico de músicos chilenos ya activos en bandas como CHC, Yaia, Funky-C y Original Hamster", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "El grupo fue un proyecto de ocupación esporádica para músicos destacados en ofertas como las de CHC, Yaia, Funky-C y Original Hamster"}, {"dato": "Su video para «Promesas» le dio fama internacional y fue recomendado por Kanye West", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Entre quienes lo vieron estuvo la estrella rap Kanye West, quien lo recomendó personalmente en su sitio web como el trabajo de una «super Chilean band»."}, {"dato": "«Somos los que estamos» tuvo edición formal en 2007 por Feria Music", "url": "https://www.musicapopular.cl/grupo/los-mono/", "cita": "Somos los que estamos tuvo una edición formal en el año 2007 por Feria Music"}]}
