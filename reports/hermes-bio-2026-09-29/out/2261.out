{"identidad_confirmada": true, "pruebas_identidad": [{"url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "Es por esto que deciden rendirle un tributo a su tierra natal. Notando el descuido y maltrato de su población y gobernantes, los 5 integrantes deciden bautizarla como ANAMUC, que no es mas que CUMANA al revés, haciendo referencia al caos que se vive diariamente en la cuidad."}, {"url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "BANDA:  ANAMUC ... GENERO:       GROOVE METAL ... CIUDAD:       CUMANÁ ... ESTADO:     SUCRE ... FECHA INICIO:     ENERO 2006"}, {"url": "https://descargasmetalvenezolano.blogspot.com/2019/12/metalkinesia-capitulo-sucre-2019.html", "cita": "05. ANAMUC - Plagio 4:30"}], "pais": {"valor": "Venezuela", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "Cumaná, Edo.Sucre, Venezuela"}, "ciudad": {"valor": "Cumaná", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "CIUDAD:       CUMANÁ"}, "año_formacion": {"valor": 2006, "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "FECHA INICIO:     ENERO 2006"}, "generos": [{"genero": "Groove Metal", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "GENERO:       GROOVE METAL"}], "datos_para_biografia": [{"dato": "La banda se formó a principios de 2006 por iniciativa de José Lara, Johnathan Coronado y Luen González.", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "A principios del 2006, por iniciativa de José Lara, Johnathan Coronado y Luen González, se crea una banda con intención de plasmar musicalmente ideas, recuerdos y vivencias de estos integrantes."}, {"dato": "Su nombre es Cumaná escrito al revés, a modo de tributo a su tierra natal.", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "deciden bautizarla como ANAMUC, que no es mas que CUMANA al revés, haciendo referencia al caos que se vive diariamente en la cuidad."}, {"dato": "Influenciados por bandas como Pantera, Sepultura, Opeth, Soulfly e In Flames.", "url": "https://corriente-rock.blogspot.com/2012/01/metal-hecho-en-venezuela-anamuc.html", "cita": "Influenciados en bandas como Pantera, Sepultura, Opeth, Soulfly, In Flames, entre otras..."}]}
