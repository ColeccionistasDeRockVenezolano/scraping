{
  "name": "crv-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Coleccionistas de Rock Venezolano — backend (ingesta, merge, API, CLI)",
  "type": "module",
  "bin": {
    "crv": "./dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "./scripts/with-node22.sh tsc -p tsconfig.json",
    "typecheck": "./scripts/with-node22.sh tsc -p tsconfig.json --noEmit",
    "lint": "./scripts/with-node22.sh tsc -p tsconfig.json --noEmit",
    "cli": "./scripts/with-node22.sh tsx src/cli/index.ts",
    "doctor": "./scripts/with-node22.sh tsx src/cli/index.ts doctor",
    "db:up": "docker compose up -d --wait crv-postgres",
    "db:down": "docker compose down -v",
    "db:migrate": "./scripts/with-node22.sh tsx src/db/migrate.ts",
    "db:bootstrap": "./scripts/db-bootstrap.sh",
    "core:catalog": "./scripts/with-node22.sh tsx scripts/gen-core-catalog.ts",
    "test": "./scripts/with-node22.sh vitest run",
    "test:watch": "./scripts/with-node22.sh vitest",
    "test:unit": "./scripts/with-node22.sh vitest run test/unit",
    "test:contract": "./scripts/with-node22.sh vitest run test/contract --pool=forks --poolOptions.forks.singleFork",
    "test:deepseek:real": "RUN_DEEPSEEK_INTEGRATION=1 ./scripts/with-node22.sh vitest run test/integration/deepseek-real.optional.test.ts",
    "adapters:fixtures": "./scripts/with-node22.sh tsx scripts/show-adapter-fixtures.ts",
    "test:matrix": "./scripts/test-pg-matrix.sh",
    "cotejo:build": "./scripts/with-node22.sh tsx scripts/build-cotejo.ts",
    "cotejo:serve": "./scripts/with-node22.sh tsx src/cotejo/server.ts",
    "radio:export": "./scripts/with-node22.sh tsx scripts/export-radio-catalog.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.5"
  }
}
